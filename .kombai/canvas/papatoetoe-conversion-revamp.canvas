    },
    "var_8d930566c216": {
      "type": "variant",
      "label": "Variant 1 — Emergency Work Order",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1380,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Barlow:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.31.0/tabler-icons.min.css');\n\n  :root {\n    --ink: #071a2b;\n    --navy: #12345a;\n    --navy-deep: #0b223d;\n    --navy-mid: #1c4a79;\n    --amber: #f6a817;\n    --amber-soft: #fff2d3;\n    --paper: #f8fafc;\n    --blue-paper: #eaf1f7;\n    --line: #cad6e0;\n    --muted: #617284;\n    --white: #ffffff;\n    --max: 1180px;\n  }\n\n  .site { min-height: 100vh; background: var(--paper); color: var(--ink); font-family: 'Barlow', system-ui, sans-serif; font-size: 16px; line-height: 1.5; }\n  .site * { box-sizing: border-box; }\n  .site h1, .site h2, .site h3, .site h4, .site .display, .site .wordmark, .site .eyebrow, .site .step-no, .site .service-no, .site .work-no { font-family: 'Barlow Condensed', Impact, sans-serif; letter-spacing: .01em; }\n  .site a { color: inherit; text-decoration: none; }\n  .site button, .site input, .site select, .site textarea { font: inherit; }\n  .container { width: min(var(--max), calc(100% - 48px)); margin-inline: auto; }\n  .icon { display: inline-flex; width: 1.25rem; height: 1.25rem; align-items: center; justify-content: center; flex: 0 0 1.25rem; line-height: 1; font-size: 1.15rem; }\n  .icon-amber { color: var(--amber); }\n  .icon-ink { color: var(--ink); }\n  .icon-navy { color: var(--navy); }\n  .eyebrow { display: inline-flex; align-items: center; gap: .55rem; color: var(--muted); font-size: .78rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }\n  .eyebrow::before { content: ''; display: inline-block; width: 1.75rem; height: 2px; background: var(--amber); }\n  .top-strip { background: var(--ink); color: var(--white); }\n  .top-strip-inner { display: flex; min-height: 36px; align-items: center; justify-content: center; gap: .7rem; padding: .45rem 0; color: rgba(255,255,255,.84); font-size: .76rem; font-weight: 600; letter-spacing: .04em; text-align: center; text-transform: uppercase; }\n  .top-strip-inner .icon { color: var(--amber); }\n  .site-header { position: sticky; top: 0; z-index: 20; border-bottom: 1px solid var(--line); background: rgba(255,255,255,.96); backdrop-filter: blur(8px); }\n  .header-inner { display: flex; min-height: 76px; align-items: center; justify-content: space-between; gap: 1.5rem; }\n  .wordmark { color: var(--ink); font-size: 1.45rem; font-weight: 700; line-height: .92; text-transform: uppercase; white-space: nowrap; }\n  .wordmark span { color: var(--amber); }\n  .main-nav { display: flex; align-items: center; gap: 1.75rem; color: var(--muted); font-size: .88rem; font-weight: 700; text-transform: uppercase; }\n  .main-nav a { position: relative; padding: .45rem 0; }\n  .main-nav a::after { position: absolute; right: 0; bottom: 0; left: 0; height: 2px; background: var(--amber); content: ''; opacity: 0; transform: scaleX(.4); transform-origin: left; transition: opacity .2s ease, transform .2s ease; }\n  .main-nav a:hover::after, .main-nav a:focus-visible::after { opacity: 1; transform: scaleX(1); }\n  .header-actions { display: flex; align-items: center; gap: .7rem; }\n  .btn { display: inline-flex; min-height: 50px; align-items: center; justify-content: center; gap: .65rem; border: 1px solid transparent; border-radius: 5px; padding: .8rem 1.25rem; font-weight: 700; line-height: 1; transition: transform .18s ease, filter .18s ease, background .18s ease; }\n  .btn:hover { filter: brightness(1.04); }\n  .btn:active { transform: translateY(1px); }\n  .btn:focus-visible, .site button:focus-visible, .site input:focus-visible, .site select:focus-visible, .site textarea:focus-visible, .site a:focus-visible { outline: 3px solid var(--amber); outline-offset: 3px; }\n  .btn-call { background: var(--amber); color: var(--ink); box-shadow: 0 7px 18px rgba(7,26,43,.17); }\n  .btn-request { background: var(--navy); color: var(--white); }\n  .btn-outline-light { border-color: rgba(255,255,255,.44); background: transparent; color: var(--white); }\n  .btn-text { min-height: 42px; padding-inline: 0; color: var(--navy); }\n  .hero { overflow: hidden; background: linear-gradient(145deg, var(--navy-deep) 0%, var(--navy) 60%, var(--navy-mid) 100%); color: var(--white); }\n  .hero-inner { display: grid; grid-template-columns: 7fr 5fr; gap: clamp(2.5rem, 5vw, 5.5rem); align-items: center; min-height: 650px; padding-top: 4.9rem; padding-bottom: 4.9rem; }\n  .hero-copy { position: relative; padding-left: 1.8rem; }\n  .hero-copy::before { position: absolute; top: .15rem; bottom: .25rem; left: 0; width: 4px; background: var(--amber); content: ''; }\n  .hero-kicker { display: inline-flex; align-items: center; gap: .55rem; color: rgba(255,255,255,.75); font-size: .78rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }\n  .hero-kicker .icon { color: var(--amber); }\n  .hero h1 { max-width: 660px; margin: 1.1rem 0 0; color: var(--white); font-size: clamp(4rem, 6.8vw, 6.25rem); font-weight: 700; line-height: .86; text-transform: uppercase; }\n  .hero-lede { max-width: 575px; margin: 1.55rem 0 0; color: rgba(255,255,255,.79); font-size: 1.2rem; line-height: 1.45; }\n  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .8rem; margin-top: 2rem; }\n  .hero-actions .btn { min-height: 58px; padding-inline: 1.4rem; font-size: 1.05rem; }\n  .urgent-note { max-width: 560px; margin: .9rem 0 0; color: rgba(255,255,255,.66); font-size: .88rem; }\n  .urgent-note strong { color: var(--amber); }\n  .proof-line { display: flex; flex-wrap: wrap; align-items: center; gap: .7rem 1rem; margin-top: 2.25rem; color: rgba(255,255,255,.88); font-size: .88rem; font-weight: 600; }\n  .proof-line span + span::before { display: inline-block; width: 1px; height: 1rem; margin-right: 1rem; background: rgba(255,255,255,.3); content: ''; vertical-align: middle; }\n  .docket { border: 1px solid rgba(255,255,255,.26); background: var(--white); color: var(--ink); box-shadow: 18px 22px 45px rgba(4,16,31,.22); }\n  .docket-head { display: grid; grid-template-columns: 1fr auto; gap: .25rem 1rem; padding: 1.35rem 1.5rem 1.2rem; background: var(--navy-deep); color: var(--white); }\n  .docket-head .eyebrow { grid-column: 1 / -1; color: var(--amber); font-size: .74rem; }\n  .docket-head .eyebrow::before { display: none; }\n  .docket-title { font-size: 2rem; font-weight: 700; line-height: .95; text-transform: uppercase; }\n  .docket-subtitle { align-self: end; color: rgba(255,255,255,.72); font-size: .9rem; text-align: right; }\n  .docket-ref { grid-column: 1 / -1; color: rgba(255,255,255,.5); font-family: 'Barlow', sans-serif; font-size: .67rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }\n  .docket-body { padding: 1.45rem 1.5rem 1.35rem; }\n  .field { display: grid; gap: .4rem; margin-top: 1rem; }\n  .field:first-child { margin-top: 0; }\n  .field-label { color: var(--ink); font-size: .86rem; font-weight: 700; }\n  .field-label small { color: var(--muted); font-weight: 500; }\n  .field input, .field select, .field textarea { width: 100%; border: 1px solid var(--line); border-radius: 3px; background: var(--paper); color: var(--ink); padding: .75rem .8rem; }\n  .field input, .field select { min-height: 47px; }\n  .field textarea { min-height: 74px; resize: vertical; }\n  .field select { appearance: auto; }\n  .selected-note { display: inline-flex; align-items: center; gap: .35rem; margin-top: .42rem; color: var(--navy); font-size: .78rem; font-weight: 700; }\n  .selected-note::before { width: .45rem; height: .45rem; border-radius: 50%; background: var(--amber); content: ''; }\n  .docket-submit { width: 100%; margin-top: 1.2rem; }\n  .docket-privacy { display: flex; gap: .45rem; align-items: flex-start; margin: .8rem 0 0; color: var(--muted); font-size: .74rem; line-height: 1.35; }\n  .docket-privacy .icon { flex: 0 0 1rem; width: 1rem; height: 1rem; color: #4f8b65; font-size: .95rem; }\n  .docket-urgent { margin: 1rem -1.5rem -1.35rem; padding: .8rem 1.5rem; border-top: 1px solid var(--line); color: var(--muted); font-size: .8rem; text-align: center; }\n  .docket-urgent a { color: var(--navy); font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }\n  .form-status { display: none; margin-top: .85rem; border-left: 3px solid var(--amber); padding: .6rem .75rem; background: var(--amber-soft); color: var(--ink); font-size: .85rem; font-weight: 600; }\n  .form-status.is-visible { display: block; }\n  .form-status.is-error { border-left-color: #b14a3b; background: #fff0ed; }\n  .process { background: var(--blue-paper); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }\n  .process-inner { padding-top: 3.6rem; padding-bottom: 3.6rem; }\n  .process-heading { max-width: 560px; }\n  .section-title { margin: .65rem 0 0; color: var(--ink); font-size: clamp(2.6rem, 4.4vw, 4.35rem); font-weight: 700; line-height: .9; text-transform: uppercase; }\n  .process-grid { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 2.2rem; }\n  .process-item { position: relative; display: grid; grid-template-columns: auto 1fr; gap: 1rem; min-height: 122px; padding: 0 2rem; }\n  .process-item:first-child { padding-left: 0; }\n  .process-item:last-child { padding-right: 0; }\n  .process-item + .process-item { border-left: 1px solid var(--line); }\n  .step-no { color: var(--amber); font-size: 2.5rem; font-weight: 700; line-height: .85; }\n  .step-icon { margin-top: .15rem; }\n  .process-item h3 { margin: 0; font-size: 1.55rem; line-height: .95; text-transform: uppercase; }\n  .process-item p { margin: .45rem 0 0; color: var(--muted); font-size: .94rem; line-height: 1.4; }\n  .proof-section { background: var(--white); }\n  .section { padding-top: 5.4rem; padding-bottom: 5.4rem; }\n  .proof-header { display: flex; align-items: end; justify-content: space-between; gap: 2rem; }\n  .proof-header-copy { max-width: 800px; }\n  .rating-line { min-width: 220px; border-top: 3px solid var(--amber); padding-top: .7rem; text-align: right; }\n  .stars { display: flex; justify-content: flex-end; gap: .15rem; color: var(--amber); font-size: 1.1rem; }\n  .rating-line strong { display: block; margin-top: .25rem; color: var(--ink); font-size: 1rem; }\n  .rating-line span { display: block; color: var(--muted); font-size: .78rem; }\n  .quote-layout { display: grid; grid-template-columns: 1.45fr .75fr; gap: 4rem; margin-top: 3.2rem; }\n  .quote-feature { border-left: 4px solid var(--amber); padding-left: 1.4rem; }\n  .quote-text { max-width: 750px; margin: .85rem 0 0; color: var(--ink); font-size: clamp(1.55rem, 2.25vw, 2.25rem); line-height: 1.18; }\n  .quote-meta { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1rem; margin-top: 1.8rem; padding-top: 1rem; border-top: 1px solid var(--line); }\n  .quote-name { font-size: 1.1rem; font-weight: 700; }\n  .quote-submeta { color: var(--muted); font-size: .83rem; }\n  .quote-job { color: var(--navy); font-size: .83rem; font-weight: 700; }\n  .quote-side { border-top: 1px solid var(--ink); }\n  .quote-side .stars { justify-content: flex-start; margin-top: .95rem; }\n  .quote-side blockquote { margin: .8rem 0 0; color: var(--ink); font-size: 1.2rem; line-height: 1.35; }\n  .quote-side .quote-meta { display: block; margin-top: 1.25rem; padding-top: .75rem; }\n  .review-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin-top: 2.5rem; padding-top: 1.2rem; border-top: 1px solid var(--line); }\n  .review-toggle { display: inline-flex; min-height: 44px; align-items: center; gap: .5rem; border: 0; background: transparent; color: var(--navy); cursor: pointer; font-weight: 700; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }\n  .review-note { color: var(--muted); font-size: .82rem; }\n  .review-more { display: none; grid-template-columns: repeat(3, 1fr); gap: 2rem; margin-top: 2rem; padding-top: 1.7rem; border-top: 1px solid var(--line); }\n  .review-more.is-open { display: grid; }\n  .review-more article { padding-left: 1rem; border-left: 2px solid var(--line); }\n  .review-more blockquote { margin: .5rem 0 0; font-size: .98rem; line-height: 1.4; }\n  .review-more p { margin: .65rem 0 0; color: var(--muted); font-size: .78rem; }\n  .services-section { background: var(--blue-paper); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }\n  .services-header { display: flex; align-items: end; justify-content: space-between; gap: 2rem; }\n  .services-intro { max-width: 670px; color: var(--muted); font-size: 1rem; }\n  .service-index { display: grid; grid-template-columns: repeat(2, 1fr); column-gap: 3.25rem; margin-top: 2.5rem; border-top: 1px solid var(--ink); }\n  .service-row { display: grid; grid-template-columns: 2rem 1.4rem 1fr auto; gap: .7rem; align-items: start; width: 100%; min-height: 116px; border: 0; border-bottom: 1px solid var(--line); background: transparent; color: var(--ink); padding: 1.2rem 0; cursor: pointer; text-align: left; }\n  .service-row:hover, .service-row.is-selected { background: rgba(255,255,255,.38); }\n  .service-row.is-selected { box-shadow: inset 4px 0 0 var(--amber); padding-left: .75rem; }\n  .service-no { color: var(--amber); font-size: 1.45rem; font-weight: 700; line-height: 1; }\n  .service-row h3 { margin: 0; font-size: 1.45rem; font-weight: 700; line-height: .95; text-transform: uppercase; }\n  .service-row p { margin: .42rem 0 0; color: var(--muted); font-size: .84rem; line-height: 1.35; }\n  .service-arrow { align-self: center; color: var(--amber); font-size: 1.15rem; opacity: .35; transition: opacity .18s ease, transform .18s ease; }\n  .service-row:hover .service-arrow, .service-row:focus-visible .service-arrow, .service-row.is-selected .service-arrow { opacity: 1; transform: translateX(3px); }\n  .service-footnote { margin-top: 1.25rem; color: var(--muted); font-size: .86rem; }\n  .service-footnote a { color: var(--navy); font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }\n  .work-section { background: var(--paper); }\n  .work-header { display: grid; grid-template-columns: .8fr 1.2fr; gap: 3rem; align-items: end; }\n  .work-header p { max-width: 560px; margin: 0; color: var(--muted); font-size: 1.05rem; }\n  .work-grid { display: grid; grid-template-columns: 1.15fr .85fr; gap: 2.2rem; align-items: start; margin-top: 3.2rem; }\n  .work-figure { margin: 0; }\n  .work-figure--offset { margin-top: 5rem; }\n  .work-image-frame { border: 1px solid var(--navy); background: var(--navy); padding: .55rem; }\n  .work-image-frame img { display: block; width: 100%; height: auto; aspect-ratio: 3 / 4; object-fit: cover; }\n  .work-caption { margin-top: .85rem; padding-top: .65rem; border-top: 2px solid var(--amber); }\n  .work-no { display: block; color: var(--amber); font-size: .9rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }\n  .work-caption strong { display: block; margin-top: .2rem; font-size: 1.15rem; line-height: 1.05; }\n  .work-caption span { display: block; margin-top: .3rem; color: var(--muted); font-size: .8rem; }\n  .areas-section { background: var(--white); border-top: 1px solid var(--line); }\n  .areas-grid { display: grid; grid-template-columns: 1.1fr repeat(3, 1fr); margin-top: 2.6rem; border-top: 2px solid var(--ink); border-bottom: 1px solid var(--line); }\n  .area-intro { min-height: 300px; padding: 1.5rem 2rem 1.5rem 0; }\n  .area-intro h3 { max-width: 210px; margin: .6rem 0 0; font-size: 2.45rem; font-weight: 700; line-height: .9; text-transform: uppercase; }\n  .area-intro p { max-width: 220px; margin: .9rem 0 0; color: var(--muted); font-size: .9rem; }\n  .area-list { min-height: 300px; margin: 0; padding: 1.35rem 1.25rem; border-left: 1px solid var(--line); list-style: none; }\n  .area-list li { display: flex; align-items: baseline; gap: .55rem; padding: .28rem 0; color: var(--ink); font-size: .88rem; }\n  .area-list li::before { width: .35rem; height: .35rem; flex: 0 0 .35rem; background: var(--amber); content: ''; }\n  .closing-cta { background: linear-gradient(135deg, var(--navy-deep), var(--navy)); color: var(--white); }\n  .closing-inner { display: grid; grid-template-columns: 1fr auto; gap: 2rem; align-items: center; padding-top: 4.25rem; padding-bottom: 4.25rem; }\n  .closing-cta .eyebrow { color: rgba(255,255,255,.68); }\n  .closing-cta .section-title { max-width: 670px; color: var(--white); }\n  .closing-copy { max-width: 620px; margin: 1rem 0 0; color: rgba(255,255,255,.72); font-size: 1.05rem; }\n  .closing-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: .7rem; }\n  .site-footer { background: var(--ink); color: var(--white); }\n  .footer-inner { display: flex; align-items: center; justify-content: space-between; gap: 2rem; padding-top: 2.1rem; padding-bottom: 2.1rem; }\n  .footer-brand { font-family: 'Barlow Condensed', sans-serif; font-size: 1.35rem; font-weight: 700; text-transform: uppercase; }\n  .footer-brand span { color: var(--amber); }\n  .footer-copy { margin-top: .25rem; color: rgba(255,255,255,.62); font-size: .8rem; }\n  .footer-phone { color: var(--amber); font-family: 'Barlow Condensed', sans-serif; font-size: 1.75rem; font-weight: 700; white-space: nowrap; }\n  .mobile-dock { display: none; }\n  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }\n\n  @media (max-width: 900px) {\n    .container { width: min(var(--max), calc(100% - 36px)); }\n    .main-nav { display: none; }\n    .hero-inner { grid-template-columns: 1fr; gap: 2.7rem; padding-top: 3.8rem; padding-bottom: 3.8rem; }\n    .hero-copy { max-width: 730px; }\n    .hero h1 { max-width: 620px; font-size: clamp(3.7rem, 10vw, 5.8rem); }\n    .process-grid { grid-template-columns: 1fr; gap: 0; }\n    .process-item, .process-item:first-child, .process-item:last-child { min-height: 0; padding: 1.25rem 0 1.25rem 1.5rem; }\n    .process-item + .process-item { border-top: 1px solid var(--line); border-left: 0; }\n    .process-item::before { position: absolute; top: 0; bottom: 0; left: 0; width: 1px; background: var(--amber); content: ''; }\n    .proof-header, .services-header { align-items: start; flex-direction: column; }\n    .rating-line { min-width: 0; width: 100%; text-align: left; }\n    .stars { justify-content: flex-start; }\n    .quote-layout { grid-template-columns: 1fr; gap: 3rem; }\n    .review-more { grid-template-columns: 1fr; gap: 1.4rem; }\n    .work-header { grid-template-columns: 1fr; gap: 1.25rem; }\n    .areas-grid { grid-template-columns: 1fr 1fr; }\n    .area-intro { grid-column: 1 / -1; min-height: 0; padding: 1.5rem 0; }\n    .area-intro h3, .area-intro p { max-width: none; }\n    .area-list { min-height: 0; }\n    .closing-inner { grid-template-columns: 1fr; }\n    .closing-actions { justify-content: flex-start; }\n  }\n\n  @media (max-width: 620px) {\n    .site { padding-bottom: 76px; }\n    .container { width: min(var(--max), calc(100% - 28px)); }\n    .top-strip-inner { min-height: 34px; padding-inline: .8rem; font-size: .65rem; line-height: 1.25; }\n    .header-inner { min-height: 68px; }\n    .wordmark { font-size: 1.12rem; }\n    .header-actions .btn-request { display: none; }\n    .header-actions .btn-call { min-height: 46px; padding-inline: .95rem; font-size: .9rem; }\n    .hero-inner { gap: 2rem; padding-top: 2.9rem; padding-bottom: 2.75rem; }\n    .hero-copy { padding-left: 1.15rem; }\n    .hero-copy::before { width: 3px; }\n    .hero h1 { margin-top: .9rem; font-size: clamp(3.1rem, 15vw, 4.65rem); line-height: .84; }\n    .hero-lede { margin-top: 1.15rem; font-size: 1.05rem; }\n    .hero-actions { align-items: stretch; flex-direction: column; margin-top: 1.5rem; }\n    .hero-actions .btn { width: 100%;