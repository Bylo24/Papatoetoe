      "html": "<link data-kid=\"1\" data-name=\"google tabler icon stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Barlow:wght@400;500;600;700&display=swap');\n\n  body { margin: 0; background: #f4f7fa; }\n  .page {\n    --navy: #12345b;\n    --navy-deep: #07192c;\n    --navy-soft: #1b4774;\n    --ink: #0d1b2d;\n    --amber: #f7a817;\n    --amber-deep: #d98a00;\n    --paper: #ffffff;\n    --mist: #edf3f8;\n    --line: #d5dee7;\n    --muted: #617080;\n    --body: 'Barlow', system-ui, sans-serif;\n    --display: 'Barlow Condensed', Impact, sans-serif;\n    min-height: 100vh;\n    color: var(--ink);\n    background: var(--paper);\n    font-family: var(--body);\n    font-size: 16px;\n    line-height: 1.45;\n    overflow: hidden;\n  }\n  .page * { box-sizing: border-box; }\n  .page a { color: inherit; text-decoration: none; }\n  .page button, .page input, .page select, .page textarea { font: inherit; }\n  .page button { cursor: pointer; }\n  .page .ti { display: inline-flex; align-items: center; justify-content: center; width: 1.1em; height: 1.1em; line-height: 1; }\n  .wrap { width: min(1160px, calc(100% - 56px)); margin: 0 auto; }\n  .eyebrow { margin: 0; color: var(--muted); font-size: 12px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }\n  .display { font-family: var(--display); letter-spacing: .01em; text-transform: uppercase; }\n  .announcement { background: var(--navy-deep); color: #f8fbff; }\n  .announcement-inner { min-height: 38px; display: flex; align-items: center; justify-content: center; gap: 10px; font-size: 13px; font-weight: 600; letter-spacing: .02em; }\n  .announcement .ti { color: var(--amber); font-size: 17px; }\n  .site-header { position: sticky; top: 0; z-index: 20; border-bottom: 1px solid rgba(13,27,45,.12); background: rgba(255,255,255,.96); backdrop-filter: blur(10px); }\n  .header-inner { min-height: 78px; display: flex; align-items: center; justify-content: space-between; gap: 28px; }\n  .brand { display: inline-flex; align-items: baseline; gap: 7px; white-space: nowrap; font-family: var(--display); font-size: 24px; font-weight: 700; letter-spacing: .01em; text-transform: uppercase; }\n  .brand strong { color: var(--amber-deep); }\n  .nav { display: flex; align-items: center; gap: 30px; margin-left: auto; color: #485665; font-size: 14px; font-weight: 600; }\n  .nav a { padding: 27px 0 25px; border-bottom: 2px solid transparent; }\n  .nav a:hover, .nav a:focus-visible { color: var(--navy); border-color: var(--amber); }\n  .header-actions { display: flex; align-items: center; gap: 10px; }\n  .call-button { display: inline-flex; align-items: center; justify-content: center; gap: 9px; min-height: 50px; padding: 0 20px; border: 1px solid var(--amber); border-radius: 7px; background: var(--amber); color: var(--ink); font-size: 16px; font-weight: 700; box-shadow: 0 8px 18px rgba(217,138,0,.17); }\n  .call-button:hover, .call-button:focus-visible { background: #ffb62e; }\n  .call-button:active { transform: translateY(1px); }\n  .header-request { display: inline-flex; align-items: center; gap: 6px; min-height: 50px; padding: 0 16px; border: 1px solid var(--navy); border-radius: 7px; background: var(--navy); color: #fff !important; font-size: 15px; font-weight: 600; }\n  .header-request:hover, .header-request:focus-visible { background: var(--navy-soft); }\n  .hero { position: relative; color: #fff; background: linear-gradient(135deg, #0d2b4c 0%, #123b67 62%, #194d7b 100%); }\n  .hero::after { content: ''; position: absolute; right: 0; top: 0; bottom: 0; width: 38%; pointer-events: none; background: linear-gradient(90deg, transparent, rgba(255,255,255,.045)); }\n  .hero-inner { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 1fr) minmax(420px, .78fr); align-items: center; gap: 78px; padding: 78px 0 84px; }\n  .hero-copy { max-width: 620px; }\n  .hero-kicker { display: flex; align-items: center; gap: 12px; color: #e8eef4; font-size: 12px; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }\n  .hero-kicker::before { content: ''; width: 31px; height: 3px; background: var(--amber); }\n  .hero h1 { max-width: 650px; margin: 19px 0 20px; font-family: var(--display); font-size: clamp(53px, 5.2vw, 76px); font-weight: 700; line-height: .91; letter-spacing: .005em; text-transform: uppercase; }\n  .hero-lede { max-width: 560px; margin: 0; color: rgba(255,255,255,.84); font-size: 19px; line-height: 1.48; }\n  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 20px; margin-top: 31px; }\n  .hero-call { min-height: 60px; padding: 0 26px; font-size: 18px; }\n  .hero-request { display: inline-flex; align-items: center; gap: 7px; padding: 10px 0; border-bottom: 1px solid rgba(255,255,255,.68); color: #fff; font-size: 17px; font-weight: 600; }\n  .hero-request:hover, .hero-request:focus-visible { border-color: var(--amber); color: var(--amber); }\n  .hero-note { max-width: 510px; margin: 13px 0 0; color: rgba(255,255,255,.66); font-size: 13px; }\n  .hero-note .ti { margin-right: 6px; color: var(--amber); }\n  .hero-proof { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; margin-top: 44px; border-top: 1px solid rgba(255,255,255,.3); }\n  .hero-proof span { padding: 15px 16px 0 0; color: rgba(255,255,255,.84); font-size: 13px; font-weight: 600; }\n  .hero-proof span + span { padding-left: 16px; border-left: 1px solid rgba(255,255,255,.18); }\n  .contact-record { position: relative; z-index: 2; width: 100%; overflow: hidden; border-radius: 13px; background: var(--paper); color: var(--ink); box-shadow: 0 24px 55px rgba(2,20,40,.25); }\n  .record-head { padding: 27px 31px 29px; background: var(--navy-deep); color: #fff; }\n  .record-head .eyebrow { color: rgba(255,255,255,.62); }\n  .record-head h2 { margin: 8px 0 7px; fo