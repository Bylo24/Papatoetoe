      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Barlow:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --navy: oklch(0.31 0.075 255);\n    --navy-deep: oklch(0.19 0.035 255);\n    --navy-soft: oklch(0.38 0.085 252);\n    --ink: oklch(0.21 0.03 250);\n    --paper: oklch(0.985 0.005 240);\n    --white: oklch(1 0 0);\n    --pale: oklch(0.94 0.012 245);\n    --pale-deep: oklch(0.9 0.022 245);\n    --muted: oklch(0.5 0.03 250);\n    --amber: oklch(0.79 0.165 72);\n    --amber-deep: oklch(0.69 0.145 68);\n    --line: oklch(0.88 0.015 245);\n    --line-dark: oklch(0.98 0.01 240 / 0.2);\n    --shadow: 0 18px 42px -24px oklch(0.19 0.035 255 / 0.55);\n  }\n\n  body {\n    margin: 0;\n    min-width: 320px;\n    background: var(--paper);\n    color: var(--ink);\n    font-family: 'Barlow', system-ui, sans-serif;\n    -webkit-font-smoothing: antialiased;\n    text-rendering: optimizeLegibility;\n  }\n\n  body, body * { box-sizing: border-box; }\n  a { color: inherit; text-decoration: none; }\n  button, input, select, textarea { font: inherit; }\n  button, a { -webkit-tap-highlight-color: transparent; }\n  .font-display, h1, h2, h3, h4 { font-family: 'Barlow Condensed', system-ui, sans-serif; }\n  .page { overflow: hidden; background: var(--paper); }\n  .shell { width: min(1120px, calc(100% - 64px)); margin-inline: auto; }\n  .icon { display: inline-flex; align-items: center; justify-content: center; width: 1.25rem; height: 1.25rem; flex: 0 0 1.25rem; line-height: 1; }\n  .icon-amber { color: var(--amber); }\n  .icon-ink { color: var(--ink); }\n  .icon-white { color: var(--white); }\n  .section-label { margin: 0 0 14px; color: var(--muted); font-size: 12px; font-weight: 700; letter-spacing: .14em; line-height: 1.2; text-transform: uppercase; }\n  .dark-label { color: color-mix(in oklab, var(--white) 68%, transparent); }\n  .section-heading { margin: 0; color: var(--ink); font-size: clamp(42px, 5vw, 64px); font-weight: 700; letter-spacing: -.02em; line-height: .94; text-transform: uppercase; }\n  .section-heading-light { color: var(--white); }\n  .body-copy { color: var(--muted); font-size: 18px; line-height: 1.5; }\n\n  .emergency-strip { background: var(--navy-deep); color: var(--white); }\n  .emergency-strip-inner { display: flex; min-height: 36px; align-items: center; justify-content: center; gap: 9px; padding: 8px 32px; color: color-mix(in oklab, var(--white) 88%, transparent); font-size: 12px; font-weight: 600; letter-spacing: .045em; text-align: center; text-transform: uppercase; }\n  .emergency-strip-inner strong { color: var(--amber); font-weight: 700; }\n\n  .site-header { position: sticky; top: 0; z-index: 30; border-bottom: 1px solid var(--line); background: color-mix(in oklab, var(--white) 96%, transparent); backdrop-filter: blur(14px); }\n  .header-inner { display: flex; min-height: 76px; align-items: center; justify-content: space-between; gap: 28px; }\n  .brand { display: inline-flex; align-items: baseline; gap: 7px; color: var(--navy-deep); font-family: 'Barlow Condensed', system-ui, sans-serif; font-size: 25px; font-weight: 700; letter-spacing: -.025em; line-height: 1; text-transform: uppercase; white-space: nowrap; }\n  .brand span { color: var(--amber-deep); }\n  .main-nav { display: flex; align-items: center; gap: 27px; margin-left: auto; color: var(--muted); font-size: 13px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }\n  .main-nav a { padding-block: 12px; }\n  .main-nav a:hover, .main-nav a:focus-visible { color: var(--navy); }\n  .header-actions { display: flex; align-items: center; gap: 9px; }\n  .btn { display: inline-flex; min-height: 48px; align-items: center; justify-content: center; gap: 9px; border: 1px solid transparent; border-radius: 6px; padding: 12px 19px; cursor: pointer; font-size: 15px; font-weight: 700; line-height: 1; transition: transform .18s ease, background-color .18s ease, border-color .18s ease; }\n  .btn:focus-visible, .incident-row:focus-visible, .service-line:focus-visible, .review-toggle:focus-visible { outline: 3px solid color-mix(in oklab, var(--amber) 75%, white); outline-offset: 3px; }\n  .btn:active { transform: translateY(1px); }\n  .btn-call { background: var(--amber); color: var(--ink); }\n  .btn-call:hover { background: oklch(0.83 0.16 72); }\n  .btn-navy { background: var(--navy); color: var(--white); }\n  .btn-navy:hover { background: var(--navy-soft); }\n  .btn-outline-light { border-color: color-mix(in oklab, var(--white) 40%, transparent); color: var(--white); }\n  .btn-outline-light:hover { background: color-mix(in oklab, var(--white) 10%, transparent); border-color: color-mix(in oklab, var(--white) 65%, transparent); }\n  .btn-lg { min-height: 58px; padding-inline: 24px; font-size: 18px; }\n  .btn-wide { width: 100%; }\n\n  .hero { position: relative; background: linear-gradient(134deg, var(--navy-deep) 0%, var(--navy) 68%, var(--navy-soft) 100%); color: var(--white); }\n  .hero::after { position: absolute; inset: auto 0 0; height: 1px; background: color-mix(in oklab, var(--white) 18%, transparent); content: ''; }\n  .hero-inner { display: grid; grid-template-columns: minmax(0, .78fr) minmax(0, 1.22fr); gap: 62px; padding: 84px 0 74px; }\n  .hero-copy { align-self: center; padding-left: 26px; border-left: 4px solid var(--amber); }\n  .hero-kicker { display: inline-flex; align-items: center; gap: 9px; margin: 0 0 20px; color: var(--amber); font-size: 12px; font-weight: 700; letter-spacing: .13em; line-height: 1.2; text-transform: uppercase; }\n  .hero-title { max-width: 490px; margin: 0; color: var(--white); font-size: clamp(74px, 8vw, 112px); font-weight: 700; letter-spacing: -.04em; line-height: .8; text-transform: uppercase; }\n  .hero-lede { max-width: 470px; margin: 26px 0 0; color: color-mix(in oklab, var(--white) 78%, transparent); font-size: 20px; line-height: 1.42; }\n  .hero-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 30px; }\n  .hero-call-note { max-width: 440px; margin: 14px 0 0; color: color-mix(in oklab, var(--white) 63%, transparent); font-size: 14px; line-height: 1.45; }\n  .hero-call-note strong { color: var(--amber); font-weight: 700; }\n  .hero-proof-line { display: flex; flex-wrap: wrap; align-items: center; gap: 0; margin-top: 38px; color: color-mix(in oklab, var(--white) 76%, transparent); font-size: 13px; font-weight: 600; line-height: 1.4; }\n  .hero-proof-line span { display: inline-flex; align-items: center; gap: 8px; padding-right: 15px; }\n  .hero-proof-line span + span { border-left: 1px solid var(--line-dark); padding-left: 15px; }\n\n  .incident-wrap { align-self: center; }\n  .incident-board { border: 1px solid color-mix(in oklab, var(--white) 24%, transparent); background: color-mix(in oklab, var(--navy-deep) 36%, transparent); }\n  .incident-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 18px; padding: 22px 24px 18px; border-bottom: 1px solid var(--line-dark); }\n  .incident-head h2 { margin: 0; color: var(--white); font-size: 34px; font-weight: 700; letter-spacing: -.015em; line-height: .92; text-transform: uppercase; }\n  .incident-head p { max-width: 205px; margin: 0; color: color-mix(in oklab, var(--white) 57%, transparent); font-size: 13px; line-height: 1.35; text-align: right; }\n  .incident-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; padding: 18px 18px 20px; }\n  .incident-row { position: relative; display: flex; min-height: 72px; align-items: center; gap: 14px; border: 1px solid color-mix(in oklab, var(--white) 24%, transparent); border-radius: 4px; background: transparent; color: var(--white); padding: 13px 16px; cursor: pointer; text-align: left; transition: background-color .18s ease, border-color .18s ease, transform .18s ease; }\n  .incident-row:hover { background: color-mix(in oklab, var(--white) 8%, transparent); border-color: color-mix(in oklab, var(--amber) 60%, transparent); transform: translateX(2px); }\n  .incident-row::after { position: absolute; right: 14px; bottom: -1px; left: 14px; height: 0; background: var(--amber); content: ''; transition: height .18s ease; }\n  .incident-row.is-selected { background: color-mix(in oklab, var(--amber) 12%, transparent); border-color: color-mix(in oklab, var(--amber) 74%, transparent); }\n  .incident-row.is-selected::after { height: 3px; }\n  .incident-row.is-selected .incident-icon { color: var(--amber); }\n  .incident-icon { color: color-mix(in oklab, var(--white) 80%, transparent); font-size: 23px; }\n  .incident-text { display: grid; gap: 3px; }\n  .incident-text strong { color: var(--white); font-size: 17px; font-weight: 700; line-height: 1.1; }\n  .incident-text small { color: color-mix(in oklab, var(--white) 54%, transparent); font-size: 12px; line-height: 1.1; }\n  .incident-selected { display: flex; min-height: 30px; align-items: center; gap: 8px; padding: 0 20px 16px; color: color-mix(in oklab, var(--white) 60%, transparent); font-size: 13px; }\n  .incident-selected strong { color: var(--amber); font-weight: 700; }\n  .action-tray { display: flex; align-items: center; gap: 11px; margin-top: 14px; }\n  .action-tray .btn-call { flex: 1 1 auto; }\n  .action-tray .btn-outline-light { flex: 0 0 auto; }\n  .action-tray-note { margin: 10px 0 0; color: color-mix(in oklab, var(--white) 57%, transparent); font-size: 12px; line-height: 1.35; }\n\n  .request-bay { border-bottom: 1px solid var(--line); background: var(--pale); }\n  .request-inner { display: grid; grid-template-columns: minmax(0, 1.12fr) minmax(270px, .88fr); gap: 70px; padding: 76px 0 82px; }\n  .request-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; }\n  .request-header h2 { margin: 0; color: var(--ink); font-size: clamp(43px, 5vw, 61px); font-weight: 700; letter-spacing: -.025em; line-height: .88; text-transform: uppercase; }\n  .request-header p { max-width: 200px; margin: 0; color: var(--muted); font-size: 14px; line-height: 1.38; text-align: right; }\n  .request-form { margin-top: 30px; }\n  .form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px 16px; }\n  .form-field { display: grid; gap: 7px; }\n  .form-field.full { grid-column: 1 / -1; }\n  .form-field label { color: var(--ink); font-size: 13px; font-weight: 700; letter-spacing: .02em; }\n  .form-field label span { color: var(--muted); font-weight: 500; }\n  .form-control { width: 100%; min-height: 50px; border: 1px solid var(--line); border-radius: 3px; background: var(--white); color: var(--ink); padding: 13px 14px; font-size: 16px; outline: none; }\n  .form-control::placeholder { color: color-mix(in oklab, var(--muted) 74%, transparent); }\n  .form-control:focus { border-color: var(--navy); box-shadow: 0 0 0 3px color-mix(in oklab, var(--navy) 14%, transparent); }\n  textarea.form-control { min-height: 104px; resize: vertical; }\n  .form-submit { display: flex; align-items: center; justify-content: space-between; gap: 14px; margin-top: 22px; }\n  .form-submit p { max-width: 320px; margin: 0; color: var(--muted); font-size: 12px; line-height: 1.35; }\n  .form-status { min-height: 20px; margin: 12px 0 0; color: var(--navy); font-size: 13px; font-weight: 600; }\n  .reassurance { align-self: start; border-left: 1px solid var(--navy); padding-left: 28px; }\n  .reassurance h3 { max-width: 250px; margin: 0; color: var(--navy); font-size: 47px; font-weight: 700; letter-spacing: -.02em; line-height: .88; text-transform: uppercase; }\n  .reassurance p { max-width: 300px; margin: 17px 0 0; color: var(--muted); font-size: 17px; line-height: 1.45; }\n  .reassurance-list { display: grid; gap: 0; margin: 34px 0 0; border-top: 1px solid var(--line); }\n  .reassurance-item { display: flex; align-items: flex-start; gap: 12px; border-bottom: 1px solid var(--line); padding: 16px 0; }\n  .reassurance-item strong { display: block; color: var(--ink); font-size: 15px; line-height: 1.18; }\n  .reassurance-item span { display: block; margin-top: 4px; color: var(--muted); font-size: 13px; line-height: 1.3; }\n  .reassurance-call { margin-top: 27px; }\n  .reassurance-call p { margin: 10px 0 0; font-size: 13px; }\n  .reassurance-call a { color: var(--navy); font-size: 20px; font-weight: 700; text-decoration: underline; text-decoration-color: var(--amber); text-underline-offset: 4px; }\n\n  .process { background: var(--white); }\n  .process-inner { padding: 72px 0 76px; }\n  .process-top { display: flex; align-items: flex-end; justify-content: space-between; gap: 28px; }\n  .process-top h2 { max-width: 570px; }\n  .process-top p { max-width: 265px; margin: 0 0 3px; color: var(--muted); font-size: 15px; line-height: 1.45; }\n  .process-line { position: relative; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 42px; margin-top: 48px; }\n  .process-line::before { position: absolute; top: 26px; right: 12%; left: 12%; height: 1px; background: var(--amber); content: ''; }\n  .process-step { position: relative; display: grid; grid-template-columns: 54px minmax(0, 1fr); gap: 16px; }\n  .process-number { display: flex; width: 54px; height: 54px; align-items: center; justify-content: center; border: 1px solid var(--navy); background: var(--white); color: var(--navy); font-family: 'Barlow Condensed', system-ui, sans-serif; font-size: 26px; font-weight: 700; line-height: 1; }\n  .process-copy h3 { margin: 3px 0 0; color: var(--ink); font-size: 27px; font-weight: 700; line-height: .95; text-transform: uppercase; }\n  .process-copy p { margin: 9px 0 0; color: var(--muted); font-size: 15px; line-height: 1.4; }\n\n  .urgent-band { background: var(--navy-deep); color: var(--white); }\n  .urgent-inner { display: flex; align-items: center; justify-content: space-between; gap: 28px; padding: 25px 0; }\n  .urgent-message { display: flex; align-items: center; gap: 16px; }\n  .urgent-message h2 { margin: 0; color: var(--white); font-size: 34px; font-weight: 700; letter-spacing: -.01em; line-height: .92; text-transform: uppercase; }\n  .urgent-message p { margin: 5px 0 0; color: color-mix(in oklab, var(--white) 61%, transparent); font-size: 13px; }\n  .urgent-phone { color: var(--amber); font-size: 26px; font-weight: 700; white-space: nowrap; }\n\n  .reviews-section { background: var(--paper); }\n  .reviews-inner { padding: 88px 0 94px; }\n  .reviews-head { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 40px; }\n  .reviews-head .section-heading { max-width: 640px; }\n  .score-block { display: grid; min-width: 202px; grid-template-columns: auto 1fr; align-items: center; gap: 13px; border-left: 3px solid var(--amber); padding-left: 16px; }\n  .score-number { color: var(--navy); font-size: 52px; font-weight: 700; line-height: .82; }\n  .score-copy { display: grid; gap: 4px; }\n  .stars { color: var(--amber); font-size: 18px; letter-spacing: .1em; line-height: 1; }\n  .score-copy strong { color: var(--ink); font-size: 14px; }\n  .score-copy span { color: var(--muted); font-size: 12px; }\n  .review-ledger { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 56px; margin-top: 48px; border-top: 1px solid var(--line); }\n  .review-entry { position: relative; border-bottom: 1px solid var(--line); padding: 27px 0 29px; }\n  .review-entry.featured { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(180px, .55fr); gap: 48px; padding-block: 32px 36px; }\n  .review-entry.featured::before { position: absolute; top: 0; bottom: 0; left: -20px; width: 4px; background: var(--amber); content: ''; }\n  .review-quote { margin: 12px 0 0; color: var(--ink); font-size: 22px; line-height: 1.38; }\n  .review-entry:not(.featured) .review-quote { max-width: 470px; font-size: 19px; }\n  .review-meta { align-self: end; padding-top: 8px; }\n  .review-meta strong { display: block; color: var(--navy); font-size: 19px; line-height: 1; }\n  .review-meta span { display: block; margin-top: 5px; color: var(--muted); font-size: 13px; line-height: 1.35; }\n  .review-job { display: inline-block; margin-top: 10px; color: var(--navy); font-size: 12px; font-weight: 700; line-height: 1.2; }\n  .review-toggle-row { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding-top: 24px; }\n  .review-toggle { display: inline-flex; align-items: center; gap: 8px; border: 0; background: transparent; color: var(--navy); padding: 0; cursor: pointer; font-size: 14px; font-weight: 700; text-decoration: underline; text-decoration-color: var(--amber); text-underline-offset: 5px; }\n  .review-toggle-note { color: var(--muted); font-size: 12px; }\n  .review-disclosure { display: none; margin-top: 20px; border-top: 1px solid var(--line); background: var(--pale); padding: 22px 24px; }\n  .review-disclosure.is-open { display: flex; align-items: center; justify-content: space-between; gap: 24px; }\n  .review-disclosure p { margin: 0; color: var(--muted); font-size: 14px; line-height: 1.4; }\n  .review-disclosure a { flex: 0 0 auto; color: var(--navy); font-size: 14px; font-weight: 700; text-decoration: underline; text-decoration-color: var(--amber); text-underline-offset: 4px; }\n\n  .services-section { border-top: 1px solid var(--line); background: var(--white); }\n  .services-inner { padding: 88px 0 92px; }\n  .services-intro { display: flex; align-items: flex-end; justify-content: space-between; gap: 30px; }\n  .services-intro p { max-width: 305px; margin: 0 0 4px; color: var(--muted); font-size: 16px; line-height: 1.45; }\n  .service-index { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 56px; margin-top: 49px; border-top: 1px solid var(--navy); }\n  .service-line { display: grid; grid-template-columns: 40px 24px minmax(0, 1fr) 20px; align-items: center; gap: 13px; width: 100%; min-height: 115px; border: 0; border-bottom: 1px solid var(--line); background: transparent; color: var(--ink); padding: 20px 0; cursor: pointer; text-align: left; }\n  .service-line:hover { color: var(--navy); }\n  .service-line:hover .service-arrow, .service-line:focus-visible .service-arrow { color: var(--amber-deep); transform: translateX(3px); }\n  .service-number { color: var(--amber-deep); font-family: 'Barlow Condensed', system-ui, sans-serif; font-size: 26px; font-weight: 700; line-height: 1; }\n  .service-icon { color: var(--navy); font-size: 21px; }\n  .service-copy { display: grid; gap: 5px; }\n  .service-copy strong { color: var(--ink); font-size: 21px; font-weight: 700; line-height: 1; text-transform: uppercase; }\n  .service-copy span { color: var(--muted); font-size: 14px; line-height: 1.34; }\n  .service-problem { color: var(--muted); font-size: 11px; font-weight: 600; letter-spacing: .04em; line-height: 1.2; text-transform: uppercase; }\n  .service-arrow { color: var(--muted); font-size: 19px; transition: transform .18s ease, color .18s ease; }\n  .service-note { margin: 22px 0 0; color: var(--muted); font-size: 13px; }\n  .service-note strong { color: var(--navy); }\n\n  .work-section { background: var(--pale); }\n  .work-inner { padding: 90px 0 96px; }\n  .work-head { display: flex; align-items: end; justify-content: space-between; gap: 32px; }\n  .work-head p { max-width: 355px; margin: 0 0 5px; color: var(--muted); font-size: 16px; line-height: 1.45; }\n  .work-spread { display: grid; grid-template-columns: minmax(0, 1.22fr) minmax(0, .78fr); align-items: start; gap: 48px; margin-top: 53px; }\n  .work-item { min-width: 0; }\n  .work-item.offset { margin-top: 64px; }\n  .work-image-frame { overflow: hidden; border: 1px solid color-mix(in oklab, var(--navy) 20%, transparent); background: var(--navy-deep); }\n  .work-item:first-child .work-image-frame { aspect-ratio: 1.37 / 1; }\n  .work-item.offset .work-image-frame { aspect-ratio: 1.03 / 1; }\n  .work-image { display: block; width: 100%; height: 100%; object-fit: cover; }\n  .work-caption { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 15px; border-top: 3px solid var(--navy); padding-top: 13px; }\n  .work-index { color: var(--amber-deep); font-family: 'Barlow Condensed', system-ui, sans-serif; font-size: 20px; font-weight: 700; line-height: 1; text-transform: uppercase; }\n  .work-caption strong { display: block; color: var(--ink); font-size: 18px; line-height: 1.15; text-transform: uppercase; }\n  .work-caption span { display: block; margin-top: 4px; color: var(--muted); font-size: 13px; line-height: 1.3; }\n\n  .areas-section { background: var(--white); }\n  .areas-inner { display: grid; grid-template-columns: minmax(220px, .62fr) minmax(0, 1.38fr); gap: 70px; padding: 86px 0 91px; }\n  .areas-lead { border-left: 4px solid var(--amber); padding-left: 22px; }\n  .areas-lead h2 { max-width: 260px; margin: 0; color: var(--navy); font-size: 58px; font-weight: 700; letter-spacing: -.02em; line-height: .85; text-transform: uppercase; }\n  .areas-lead p { max-width: 240px; margin: 18px 0 0; color: var(--muted); font-size: 16px; line-height: 1.45; }\n  .area-board { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--navy); border-left: 1px solid var(--line); }\n  .area-block { min-height: 161px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 20px 22px 22px; }\n  .area-block h3 { margin: 0 0 14px; color: var(--navy); font-size: 22px; font-weight: 700; line-height: 1; text-transform: uppercase; }\n  .area-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 7px 15px; margin: 0; padding: 0; list-style: none; }\n  .area-list li { display: flex; align-items: center; gap: 7px; color: var(--muted); font-size: 13px; line-height: 1.25; }\n  .area-dot { display: inline-flex; width: 6px; height: 6px; flex: 0 0 6px; border-radius: 999px; background: var(--amber); }\n\n  .final-cta { background: linear-gradient(133deg, var(--navy-deep), var(--navy)); color: var(--white); }\n  .final-inner { display: flex; align-items: center; justify-content: space-between; gap: 42px; padding: 72px 0 76px; }\n  .final-inner h2 { max-width: 625px; margin: 0; color: var(--white); font-size: clamp(48px, 6vw, 78px); font-weight: 700; letter-spacing: -.035em; line-height: .84; text-transform: uppercase; }\n  .final-side { display: grid; justify-items: start; gap: 15px; }\n  .final-side p { max-width: 250px; margin: 0; color: color-mix(in oklab, var(--white) 65%, transparent); font-size: 15px; line-height: 1.4; }\n  .final-actions { display: flex; flex-wrap: wrap; gap: 10px; }\n\n  .site-footer { background: var(--navy-deep); color: var(--white); }\n  .footer-inner { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 31px 0 35px; }\n  .footer-brand { color: var(--white); font-family: 'Barlow Condensed', system-ui, sans-serif; font-size: 23px; font-weight: 700; line-height: 1; text-transform: uppercase; }\n  .footer-brand span { color: var(--amber); }\n  .footer-copy { margin: 7px 0 0; color: color-mix(in oklab, var(--white) 57%, transparent); font-size: 13px; line-height: 1.3; }\n  .footer-phone { color: var(--amber); font-size: 23px; font-weight: 700; white-space: nowrap; }\n  .mobile-dock { display: none; }\n\n  @media (max-width: 980px) {\n    .shell { width: min(100% - 40px, 720px); }\n    .main-nav { display: none; }\n    .hero-inner { grid-template-columns: 1fr; gap: 48px; padding-block: 61px 65px; }\n    .hero-copy { max-width: 700px; }\n    .incident-wrap { max-width: 760px; }\n    .request-inner { grid-template-columns: 1fr; gap: 50px; }\n    .reassurance { max-width: 760px; }\n    .areas-inner { grid-template-columns: 1fr; gap: 42px; }\n    .areas-lead h2 { max-width: 470px; }\n  }\n\n  @media (max-width: 640px) {\n    .shell { width: calc(100% - 32px); }\n    .emergency-strip-inner { min-height