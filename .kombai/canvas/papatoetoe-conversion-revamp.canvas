x(0, 1fr) 16px; gap: 8px; min-height: 112px; padding-block: 17px; }\n    .service-copy strong { font-size: 18px; }\n    .service-copy span { font-size: 13px; }\n    .service-problem { font-size: 10px; }\n    .work-spread { grid-template-columns: 1fr; gap: 35px; margin-top: 34px; }\n    .work-item.offset { margin-top: 0; margin-left: 28px; }\n    .work-item:first-child .work-image-frame, .work-item.offset .work-image-frame { aspect-ratio: 1.08 / 1; }\n\n    .areas-inner { gap: 34px; padding-block: 57px 64px; }\n    .areas-lead h2 { font-size: 53px; }\n    .areas-lead p { margin-top: 14px; }\n    .area-board { grid-template-columns: 1fr 1fr; }\n    .area-block { min-height: 205px; padding: 17px 13px 19px; }\n    .area-block h3 { font-size: 18px; }\n    .area-list { grid-template-columns: 1fr; gap: 7px; }\n    .area-list li { font-size: 12px; }\n\n    .final-inner { display: block; padding-block: 56px 60px; }\n    .final-inner h2 { font-size: 56px; }\n    .final-side { margin-top: 27px; }\n    .final-side p { max-width: 310px; }\n    .final-actions { display: grid; width: 100%; }\n    .final-actions .btn { width: 100%; }\n    .footer-inner { align-items: flex-start; display: grid; gap: 20px; padding-block: 28px 31px; }\n    .footer-phone { font-size: 22px; }\n    .mobile-dock { position: fixed; right: 0; bottom: 0; left: 0; z-index: 40; display: grid; grid-template-columns: 1.12fr .88fr; gap: 8px; border-top: 1px solid var(--line); background: var(--white); padding: 10px 12px calc(10px + env(safe-area-inset-bottom)); }\n    .mobile-dock .btn { min-height: 52px; padding-inline: 10px; font-size: 15px; }\n    .mobile-dock-spacer { display: block; height: 82px; }\n  }\n</style>\n<div class=\"page\" data-kid=\"1\">\n    <div class=\"emergency-strip\" data-kid=\"1-1\">\n        <div class=\"emergency-strip-inner\" data-kid=\"1-1-1\">\n            <i aria-hidden=\"true\" class=\"ti ti-clock icon icon-amber\" data-kid=\"1-1-1-1\">\n            </i>\n            <span data-kid=