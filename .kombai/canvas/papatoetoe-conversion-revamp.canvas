uto; padding: 23px 0; }\n    .review:nth-child(3) { border-left: 0; }\n    .review + .review { border-top: 1px solid #c9d4dd; }\n    .review-feature .quote { font-size: 18px; }\n    .review-more { grid-template-columns: 1fr; gap: 12px; }\n    .service-register { grid-template-columns: 1fr; margin-top: 28px; }\n    .service-trigger { min-height: 68px; grid-template-columns: 38px 1fr 22px; }\n    .service-name { font-size: 24px; }\n    .service-detail { padding-left: 38px; }\n    .evidence-spread { grid-template-columns: 1fr; gap: 21px; margin-top: 30px; padding: 16px 16px 20px; }\n    .evidence-card-offset { margin-top: 0; }\n    .evidence-card img, .evidence-card-offset img { aspect-ratio: 1 / .8; }\n    .area-register { grid-template-columns: repeat(2, 1fr); gap: 28px 19px; margin-top: 30px; }\n    .area-group { padding-left: 11px; }\n    .area-group h3 { font-size: 21px; }\n    .area-group li { font-size: 13px; }\n    .cta-band { padding: 60px 0 65px; }\n    .cta-band h2 { font-size: 46px; }\n    .footer { padding-bottom: 25px; }\n    .footer-inner { align-items: flex-start; flex-direction: column; gap: 11px; }\n    .footer-phone { font-size: 27px; }\n    .mobile-dock { position: fixed; left: 0; right: 0; bottom: 0; z-index: 30; display: grid; grid-template-columns: 1.15fr .85fr; gap: 8px; padding: 10px 12px calc(10px + env(safe-area-inset-bottom)); border-top: 1px solid rgba(13,27,45,.14); background: rgba(255,255,255,.98); box-shadow: 0 -8px 23px rgba(13,27,45,.09); }\n    .mobile-dock a { display: inline-flex; align-items: center; justify-content: center; gap: 7px; min-height: 53px; border-radius: 6px; font-size: 15px; font-weight: 700; }\n    .mobile-dock .dock-call { background: var(--amber); color: var(--ink); }\n    .mobile-dock .dock-request { background: var(--navy); color: #fff; }\n  }\n</style>\n<div class=\"page\" data-kid=\"2\" data-name=\"page layout container\" id=\"top\">\n    <div class=\"announcement\" data-kid=\"2-1\" data-name=\"announcement ba