rgent-message\" data-kid=\"1-3-4-1-1\">\n                    <i aria-hidden=\"true\" class=\"ti ti-phone-call icon icon-amber\" data-kid=\"1-3-4-1-1-1\">\n                    </i>\n                    <div data-kid=\"1-3-4-1-1-2\">\n                        <h2 data-kid=\"1-3-4-1-1-2-1\">\n                            For urgent problems, call first.\n                        </h2>\n                        <p data-kid=\"1-3-4-1-1-2-2\">\n                            Requests are useful when you would prefer a callback.\n                        </p>\n                    </div>\n                </div>\n                <a class=\"urgent-phone\" data-kid=\"1-3-4-1-2\" href=\"tel:+6498844104\">\n                    64 9 8844104\n                </a>\n            </div>\n        </section>\n        <section class=\"reviews-section\" data-kid=\"1-3-5\" id=\"reviews\">\n            <div class=\"shell reviews-inner\" data-kid=\"1-3-5-1\">\n                <div class=\"reviews-head\" data-kid=\"1-3-5-1-1\">\n                    <div data-kid=\"1-3-5-1-1-1\">\n                        <p class=\"section-label\" data-kid=\"1-3-5-1-1-1-1\">\n                            Real customer proof\n                        </p>\n                        <h2 class=\"section-heading\" data-kid=\"1-3-5-1-1-1-2\">\n                            5-star local plumbing service.\n                        </h2>\n                    </div>\n                    <div class=\"score-block\" data-kid=\"1-3-5-1-1-2\">\n                        <div class=\"score-number\" data-kid=\"1-3-5-1-1-2-1\">\n                            5.0\n                        </div>\n                        <div class=\"score-copy\" data-kid=\"1-3-5-1-1-2-2\">\n                            <div aria-label=\"5 out of 5 stars\" class=\"stars\" data-kid=\"1-3-5-1-1-2-2-1\">\n                                ★★★★★\n                            </div>\n                            <strong data-kid=\"1-3-5-1-1-2-2-2\">\n                                Google rating\n                            </strong>\n                            <span data-kid=\"1-3-5-1-1-2-2-3\">\n                                9 reviews · local customers\n                            </span>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"review-ledger\" data-kid=\"1-3-5-1-2\">\n                    <article class=\"review-entry featured\" data-kid=\"1-3-5-1-2-1\">\n                        <div data-kid=\"1-3-5-1-2-1-1\">\n                            <div aria-label=\"5 out of 5 stars\" class=\"stars\" data-kid=\"1-3-5-1-2-1-1-1\">\n                                ★★★★★\n                            </div>\n                            <p class=\"review-quote\" data-kid=\"1-3-5-1-2-1-1-2\">\n                                “Outstanding service from Papatoetoe Plumbing & Gas. From the first contact they were responsive, professional and very clear about pricing. The plumber arrived on time, diagnosed the issue quickly and completed the job to a very high standard. Everything was left clean and tidy, with great attention to detail. Fair price, excellent workmanship and great communication. Highly recommend - 5 stars!”\n                            </p>\n                        </div>\n                        <div class=\"review-meta\" data-kid=\"1-3-5-1-2-1-2\">\n                            <strong data-kid=\"1-3-5-1-2-1-2-1\">\n                                Cesar Gil\n                            </strong>\n                            <span data-kid=\"1-3-5-1-2-1-2-2\">\n                                Papatoetoe · 3 days ago\n                            </span>\n                            <span class=\"review-job\" data-kid=\"1-3-5-1-2-1-2-3\">\n                                Outdoor plumbing system repair\n                            </span>\n                        </div>\n                    </article>\n                    <article class=\"review-entry\" data-kid=\"1-3-5-1-2-2\">\n                        <div aria-label=\"5 out of 5 stars\" class=\"stars\" data-kid=\"1-3-5-1-2-2-1\">\n                            ★★★★★\n                        </div>\n                        <p class=\"review-quote\" data-kid=\"1-3-5-1-2-2-2\">\n                            “Did a fantastic job fixing up a leak underneath our floor. Arrived on time and job was done to a high standard - good price too! Cheers mate.”\n                        </p>\n                        <div class=\"review-meta\" data-kid=\"1-3-5-1-2-2-3\">\n                            <strong data-kid=\"1-3-5-1-2-2-3-1\">\n                                Oliver Compton\n                            </strong>\n                            <span data-kid=\"1-3-5-1-2-2-3-2\">\n                                South Auckland · 4 days ago\n                            </span>\n                            <span class=\"review-job\" data-kid=\"1-3-5-1-2-2-3-3\">\n                                Great price · $200–400\n                            </span>\n                        </div>\n                    </article>\n                    <article class=\"review-entry\" data-kid=\"1-3-5-1-2-3\">\n                        <div aria-label=\"5 out of 5 stars\" class=\"stars\" data-kid=\"1-3-5-1-2-3-1\">\n                            ★★★★★\n                        </div>\n                        <p class=\"review-quote\" data-kid=\"1-3-5-1-2-3-2\">\n                            “Highly recommend! Had my hot water cylinder replaced and couldn’t be happier with the service. Great communication, punctual, and reasonably priced. Really easy to deal with from start to finish.”\n                        </p>\n                        <div class=\"review-meta\" data-kid=\"1-3-5-1-2-3-3\">\n                            <strong data-kid=\"1-3-5-1-2-3-3-1\">\n                                Damith Herath\n                            </strong>\n                            <span data-kid=\"1-3-5-1-2-3-3-2\">\n    