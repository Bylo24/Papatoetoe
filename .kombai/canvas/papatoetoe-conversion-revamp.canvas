now · 64 9 8844104\n                            </span>\n                        </a>\n                        <a class=\"btn btn-outline-light\" data-kid=\"1-3-1-1-1-4-2\" href=\"#request\">\n                            Request service\n                        </a>\n                    </div>\n                    <p class=\"urgent-note\" data-kid=\"1-3-1-1-1-5\">\n                        <strong data-kid=\"1-3-1-1-1-5-1\">\n                            For urgent leaks, overflowing toilets or water shutoffs, call rather than waiting for a callback.\n                        </strong>\n                    </p>\n                    <div aria-label=\"Service assurances\" class=\"proof-line\" data-kid=\"1-3-1-1-1-6\">\n                        <span data-kid=\"1-3-1-1-1-6-1\">\n                            24/7 emergency plumbing\n                        </span>\n                        <span data-kid=\"1-3-1-1-1-6-2\">\n                            Clear pricing before work starts\n                        </span>\n                        <span data-kid=\"1-3-1-1-1-6-3\">\n                            Papatoetoe & South Auckland\n                        </span>\n                    </div>\n                </div>\n                <div class=\"docket-wrap\" data-kid=\"1-3-1-1-2\" id=\"request\">\n                    <form class=\"docket\" data-kid=\"1-3-1-1-2-1\" id=\"request-form\">\n                        <div class=\"docket-head\" data-kid=\"1-3-1-1-2-1-1\">\n                            <span class=\"eyebrow\" data-kid=\"1-3-1-1-2-1-1-1\">\n                                Work docket · request service\n                            </span>\n                            <strong class=\"docket-title\" data-kid=\"1-3-1-1-2-1-1-2\">\n                                Prefer a callback?\n                            </strong>\n                            <span class=\"docket-subtitle\" data-kid=\"1-3-1-1-2-1-1-3\">\n                                We’ll call you back.\n                            </span>\n                            <span class=\"docket-ref\" data-kid=\"1-3-1-1-2-1-1-4\">\n                                Papatoetoe plumbing & gas · job intake 01\n                            </span>\n                        </div>\n                        <div class=\"docket-body\" data-kid=\"1-3-1-1-2-1-2\">\n                            <div class=\"field\" data-kid=\"1-3-1-1-2-1-2-1\">\n                                <label class=\"field-label\" data-kid=\"1-3-1-1-2-1-2-1-1\" for=\"service\">\n                                    What do you need help with?\n                                </label>\n                                <select data-kid=\"1-3-1-1-2-1-2-1-2\" id=\"service\" name=\"service\">\n                                    <option data-kid=\"1-3-1-1-2-1-2-1-2-1\">\n                                        Emergency plumbing\n                                    </option>\n                                    <option data-kid=\"1-3-1-1-2-1-2-1-2-2\">\n                                        Leak repairs\n                                    </option>\n                                    <option data-kid=\"1-3-1-1-2-1-2-1-2-3\">\n                                        Blocked drains\n                                    </option>\n                                    <option data-kid=\"1-3-1-1-2-1-2-1-2-4\">\n                                        Hot water\n                                    </option>\n                                    <option data-kid=\"1-3-1-1-2-1-2-1-2-5\">\n                                        Gas fitting\n                                    </option>\n                                    <option data-kid=\"1-3-1-1-2-1-2-1-2-6\">\n                                        Bathrooms & fixtures\n                                    </option>\n                                    <option data-kid=\"1-3-1-1-2-1-2-1-2-7\">\n                                        Other (describe if not listed)\n                      