iv aria-label=\"Service assurances\" class=\"hero-proof-line\" data-kid=\"1-3-1-1-1-6\">\n                        <span data-kid=\"1-3-1-1-1-6-1\">\n                            <i aria-hidden=\"true\" class=\"ti ti-shield-check icon icon-amber\" data-kid=\"1-3-1-1-1-6-1-1\">\n                            </i>\n                            Qualified & insured\n                        </span>\n                        <span data-kid=\"1-3-1-1-1-6-2\">\n                            <i aria-hidden=\"true\" class=\"ti ti-receipt icon icon-amber\" data-kid=\"1-3-1-1-1-6-2-1\">\n                            </i>\n                            Clear pricing before work\n                        </span>\n                        <span data-kid=\"1-3-1-1-1-6-3\">\n                            <i aria-hidden=\"true\" class=\"ti ti-map-pin icon icon-amber\" data-kid=\"1-3-1-1-1-6-3-1\">\n                            </i>\n                            Local South Auckland service\n                        </span>\n                    </div>\n                </div>\n                <div class=\"incident-wrap\" data-kid=\"1-3-1-1-2\">\n                    <div aria-labelledby=\"incident-heading\" class=\"incident-board\" data-kid=\"1-3-1-1-2-1\">\n                        <div class=\"incident-head\" data-kid=\"1-3-1-1-2-1-1\">\n                            <h2 data-kid=\"1-3-1-1-2-1-1-1\" id=\"incident-heading\">\n                                Choose the closest problem\n                            </h2>\n                            <p data-kid=\"1-3-1-1-2-1-1-2\">\n                                We’ll use your choice to prefill the request. It does not diagnose the job.\n                            </p>\n                        </div>\n                        <div class=\"incident-grid\" data-kid=\"1-3-1-1-2-1-2\">\n                            <button aria-pressed=\"true\" class=\"incident-row is-selected\" data-kid=\"1-3-1-1-2-1-2-1\" data-name=\"problem selection button - water leaking\" 