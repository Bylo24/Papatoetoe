ile-dock .btn { min-height: 52px; padding-inline: .7rem; font-size: .93rem; }\n  }\n</style>\n<div class=\"site\" data-kid=\"1\" id=\"top\">\n    <div class=\"top-strip\" data-kid=\"1-1\">\n        <div class=\"container top-strip-inner\" data-kid=\"1-1-1\">\n            <span aria-hidden=\"true\" class=\"icon icon-amber\" data-kid=\"1-1-1-1\">\n                <i class=\"ti ti-clock\" data-kid=\"1-1-1-1-1\">\n                </i>\n            </span>\n            <span data-kid=\"1-1-1-2\">\n                24/7 emergency plumber in Papatoetoe · Same-day hot water, drains & gas · 64 9 8844104\n            </span>\n        </div>\n    </div>\n    <header class=\"site-header\" data-kid=\"1-2\">\n        <div class=\"container header-inner\" data-kid=\"1-2-1\">\n            <a aria-label=\"Papatoetoe Plumbing and Gas home\" class=\"wordmark\" data-kid=\"1-2-1-1\" href=\"#top\">\n                Papatoetoe\n                <span data-kid=\"1-2-1-1-1\">\n                    Plumbing & Gas\n                </span>\n            </a>\n            <nav aria-label=\"Primary navigation\" class=\"main-nav\" data-kid=\"1-2-1-2\">\n                <a data-kid=\"1-2-1-2-1\" href=\"#services\">\n                    Services\n                </a>\n                <a data-kid=\"1-2-1-2-2\" href=\"#reviews\">\n                    Reviews\n                </a>\n                <a data-kid=\"1-2-1-2-3\" href=\"#work\">\n                    Work\n                </a>\n                <a data-kid=\"1-2-1-2-4\" href=\"#areas\">\n                    Areas\n                </a>\n            </nav>\n            <div class=\"header-actions\" data-kid=\"1-2-1-3\">\n                <a class=\"btn btn-call\" data-kid=\"1-2-1-3-1\" href=\"tel:+6498844104\">\n                    <span aria-hidden=\"true\" class=\"icon icon-ink\" data-kid=\"1-2-1-3-1-1\">\n                        <i class=\"ti ti-phone-call\" data-kid=\"1-2-1-3-1-1-1\">\n                        </i>\n                    </span>\n  