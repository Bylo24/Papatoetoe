burb\" placeholder=\"e.g. Papatoetoe\"/>\n                            </div>\n                            <div class=\"field\" data-kid=\"1-3-1-1-2-1-2-5\">\n                                <label class=\"field-label\" data-kid=\"1-3-1-1-2-1-2-5-1\" for=\"details\">\n                                    Details\n                                    <small data-kid=\"1-3-1-1-2-1-2-5-1-1\">\n                                        Optional\n                                    </small>\n                                </label>\n                                <textarea data-kid=\"1-3-1-1-2-1-2-5-2\" id=\"details\" name=\"details\" placeholder=\"e.g. Burst pipe under kitchen sink\" rows=\"2\"></textarea>\n                            </div>\n                            <button class=\"btn btn-call docket-submit\" data-kid=\"1-3-1-1-2-1-2-6\" id=\"submit-request\" type=\"submit\">\n                                <span aria-hidden=\"true\" class=\"icon icon-ink\" data-kid=\"1-3-1-1-2-1-2-6-1\">\n                                    <i class=\"ti ti-send\" data-kid=\"1-3-1-1-2-1-2-6-1-1\">\n                                    </i>\n                                </span>\n                                <span data-dynamic=\"true\" data-kid=\"1-3-1-1-2-1-2-6-2\" data-name=\"submit button label text\" data-reason=\"text replaced by script during submission process\">\n                                    Send request\n                                </span>\n                            </button>\n                            <div aria-live=\"polite\" class=\"form-status\" data-dynamic=\"true\" data-kid=\"1-3-1-1-2-1-2-7\" data-name=\"form status message display area\" data-reason=\"text content populated by script after form submission\" id=\"form-status\" role=\"status\">\n                            </div>\n                            <p class=\"docket-privacy\" data-kid=\"1-3-1-1-2-1-2-8\">\n                                <span aria-hidden=\"true\" class=\"icon\" data-kid=\"1-3-1-1-2-1-2-8-1\">\n                                    <i class=\"ti ti-lock\" data-kid=\"1-3-1-1-2-1-2-8-1-1\">\n                                    </i>\n                                </span>\n                                <span data-kid=\"1-3-1-1-2-1-2-8-2\">\n                                    Your details are used only to respond to this service request.\n                                </span>\n                            </p>\n                            <p class=\"docket-urgent\" data-kid=\"1-3-1-1-2-1-2-9\">\n                                For emergencies, call instead:\n                                <a data-kid=\"1-3-1-1-2-1-2-9-1\" href=\"tel:+6498844104\">\n                                    64 9 8844104\n                                </a>\n                            </p>\n                        </div>\n                    </form>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"process-title\" class=\"process\" data-kid=\"1-3-2\">\n            <div class=\"container process-inner\" data-kid=\"1-3-2-1\">\n                <div class=\"process-heading\" data-kid=\"1-3-2-1-1\">\n                    <span class=\"eyebrow\" data-kid=\"1-3-2-1-1-1\">\n                        Before work starts\n                    </span>\n                    <h2 class=\"section-title\" data-kid=\"1-3-2-1-1-2\" id=\"process-title\">\n                        What happens after you contact us\n                    </h2>\n                </div>\n                <div class=\"process-grid\" data-kid=\"1-3-2-1-2\">\n                    <article class=\"process-item\" data-kid=\"1-3-2-1-2-1\">\n                        <span class=\"step-no\" data-kid=\"1-3-2-1-2-1-1\">\n                            01\n                        </span>\n                        <div data-kid=\"1-3-2-1-2-1-2\">\n                            <span aria-hidden=\"true\" class=\"icon icon-navy step-icon\" data-kid=\"1-3-2-1-2-1-2-1\">\n                                <i class=\"ti ti-phone-call\" data-kid=\"1-3-2-1-2-1-2-1-1\">\n                                </i>\n                            </span>\n                            <h3 data-kid=\"1-3-2-1-2-1-2-2\">\n                                Call or send a request\n                            </h3>\n                            <p data-kid=\"1-3-2-1-2-1-2-3\">\n                                Call for urgent help, or leave your number and a short description if you’d prefer a callback.\n                            </p>\n                        </div>\n                    </article>\n                    <article class=\"process-item\" data-kid=\"1-3-2-1-2-2\">\n                        <span class=\"step-no\" data-kid=\"1-3-2-1-2-2-1\">\n                            02\n                        </span>\n                        <div data-kid=\"1-3-2-1-2-2-2\">\n                            <span aria-hidden=\"true\" class=\"icon icon-navy step-icon\" data-kid=\"1-3-2-1-2-2-2-1\">\n                                <i class=\"ti ti-message-square-text\" data-kid=\"1-3-2-1-2-2-2-1-1\">\n                                </i>\n                            </span>\n                            <h3 data-kid=\"1-3-2-1-2-2-2-2\">\n                                Confirm the job details\n                            </h3>\n                            <p data-kid=\"1-3-2-1-2-2-2-3\">\n                                We confirm what needs attention and the practical next step for your plumbing or gas job.\n                            </p>\n                        </div>\n                    </article>\n                    <article class=\"process-item\" data-kid=\"1-3-2-1-2-3\">\n                        <span class=\"step-no\" data-kid=\"1-3-2-1-2-3-1\">\n                            03\n                        </span>\n                        <div data-kid=\"1-3-2-1-2-3-2\">\n                            <span aria-hidden=\"true\" class=\"icon icon-navy step-icon\" data-kid=\"1-3-2-1-2-3-2-1\">\n                                <i class=\"ti ti-receipt\" data-kid=\"1-3-2-1-2-3-2-1-1\">\n                                </i>\n                            </span>\n                            <h3 data-kid=\"1-3-2-1-2-3-2-2\">\n                                Clear advice before work\n                            </h3>\n                            <p data-kid=\"1-3-2-1-2-3-2-3\">\n                                You get clear advice and pricing before work starts, with tidy repairs as the goal.\n                            </p>\n                        </div>\n                    </article>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"reviews-title\" class=\"proof-section section\" data-kid=\"1-3-3\" id=\"reviews\">\n            <div class=\"container\" data-kid=\"1-3-3-1\">\n                <div class=\"proof-header\" data-kid=\"1-3-3-1-1\">\n                    <div class=\"proof-header-copy\" data-kid=\"1-3-3-1-1-1\">\n                        <span class=\"eyebrow\" data-kid=\"1-3-3-1-1-1-1\">\n                            Recent local customers\n                        </span>\n                        <h2 class=\"section-title\" data-kid=\"1-3-3-1-1-1-2\" id=\"reviews-title\">\n                            5-star plumbing service across South Auckland.\n                        </h2>\n                    </div>\n                    <div aria-label=\"5.0 on Google, 9 reviews\" class=\"rating-line\" data-kid=\"1-3-3-1-1-2\">\n                        <div aria-hidden=\"true\" class=\"stars\" data-kid=\"1-3-3-1-1-2-1\">\n                            <span data-kid=\"1-3-3-1-1-2-1-1\">\n                                ★\n                            </span>\n                            <span data-kid=\"1-3-3-1-1-2-1-2\">\n                                ★\n                            </span>\n                            <span data-kid=\"1-3-3-1-1-2-1-3\">\n                                ★\n                            </span>\n                            <span data-kid=\"1-3-3-1-1-2-1-4\">\n                                ★\n                            </span>\n                            <span data-kid=\"1-3-3-1-1-2-1-5\">\n                                ★\n                            </span>\n                        </div>\n                        <strong data-kid=\"1-3-3-1-1-2-2\">\n                            5.0 on Google · 9 reviews\n                        </strong>\n                        <span data-kid=\"1-3-3-1-1-2-3\">\n                            Real customer feedback\n                        </span>\n                    </div>\n                </div>\n                <div class=\"quote-layout\" data-kid=\"1-3-3-1-2\">\n                    <article class=\"quote-feature\" data-kid=\"1-3-3-1-2-1\">\n                        <div aria-hidden=\"true\" class=\"stars\" data-kid=\"1-3-3-1-2-1-1\">\n                            <span data-kid=\"1-3-3-1-2-1-1-1\">\n                                ★\n                            </span>\n                            <span data-kid=\"1-3-3-1-2-1-1-2\">\n                                ★\n                            </span>\n                            <span data-kid=\"1-3-3-1-2-1-1-3\">\n                                ★\n                            </span>\n                            <span data-kid=\"1-3-3-1-2-1-1-4\">\n                                ★\n                            </span>\n                            <span data-kid=\"1-3-3-1-2-1-1-5\">\n                                ★\n                            </span>\n                        </div>\n                        <blockquote class=\"quote-text\" data-kid=\"1-3-3-1-2-1-2\">\n                            “Outstanding service from Papatoetoe Plumbing & Gas. From the first contact they were responsive, professional and very clear about pricing. The plumber arrived on time, diagnosed the issue quickly and completed the job to a very high standard. Everything was left clean and tidy, with great attention to detail. Fair price, excellent workmanship and great communication. Highly recommend - 5 stars!”\n                        </blockquote>\n                        <div class=\"quote-meta\" data-kid=\"1-3-3-1-2-1-3\">\n                            <div data-kid=\"1-3-3-1-2-1-3-1\">\n                                <div class=\"quote-name\" data-kid=\"1-3-3-1-2-1-3-1-1\">\n                                    Cesar Gil\n                                </div>\n                                <div class=\"quote-submeta\" data-kid=\"1-3-3-1-2-1-3-1-2\">\n                                    Papatoetoe · 3 days ago\n                                </div>\n                            </div>\n                            <div class=\"quote-job\" data-kid=\"1-3-3-1-2-1-3-2\">\n                                Outdoor plumbing system repair\n                            </div>\n                        </div>\n                    </article>\n                    <article class=\"quote-side\" data-kid=\"1-3-3-1-2-2\">\n                        <div aria-hidden=\"true\" class=\"stars\" data-kid=\"1-3-3-1-2-2-1\">\n                            <span data-kid=\"1-3-3-1-2-2-1-1\">\n                                ★\n                            </span>\n                            <span data-kid=\"1-3-3-1-2-2-1-2\">\n                                ★\n                            </span>\n                            <span data-kid=\"1-3-3-1-2-2-1-3\">\n                                ★\n                            </span>\n                            <span data-kid=\"1-3-3-1-2-2-1-4\">\n                                ★\n                            </span>\n                            <span data-kid=\"1-3-3-1-2-2-1-5\">\n                                ★\n                            </span>\n                        </div>\n                        <blockquote data-kid=\"1-3-3-1-2-2-2\">\n                            “Did a fantastic job fixing up a leak underneath our floor. Arrived on time and job was done to a high standard - good price too! Cheers mate.”\n                        </blockquote>\n                        <div class=\"quote-meta\" data-kid=\"1-3-3-1-2-2-3\">\n                            <div class=\"quote-name\" data-kid=\"1-3-3-1-2-2-3-1\">\n                                Oliver Compton\n                            </div>\n                            <div class=\"quote-submeta\" data-kid=\"1-3-3-1-2-2-3-2\">\n                                South Auckland · 4 days ago\n                            </div>\n                            <div class=\"quote-job\" data-kid=\"1-3-3-1-2-2-3-3\">\n                                Great price · $200–400\n                            </div>\n                        </div>\n                    </article>\n                </div>\n                <div class=\"review-actions\" data-kid=\"1-3-3-1-3\">\n                    <button aria-controls=\"review-more\" aria-expanded=\"false\" class=\"review-toggle\" data-dynamic=\"true\" data-kid=\"1-3-3-1-3-1\" data-name=\"read more reviews button\" data-reason=\"text toggled between 'Read all...' and 'Hide additional...' by script\" id=\"reviews-toggle\" type=\"button\">\n                        <span data-kid=\"1-3-3-1-3-1-1\">\n                            Read all Google reviews\n                        </span>\n                        <span aria-hidden=\"true\" class=\"icon icon-navy\" data-kid=\"1-3-3-1-3-1-2\">\n                            <i class=\"ti ti-arrow-down\" data-dynamic=\"true\" data-kid=\"1-3-3-1-3-1-2-1\" data-name=\"review section toggle icon\" data-reason=\"icon class changed by script\">\n                            </i>\n                        </span>\n                    </button>\n                    <span class=\"review-note\" data-kid=\"1-3-3-1-3-2\">\n                        Selected reviews shown above; open the full list when you want more detail.\n                    </span>\n                </div>\n                <div aria-hidden=\"true\" class=\"review-more\" data-dynamic=\"true\" data-kid=\"1-3-3-1-4\" data-name=\"hidden reviews container\" data-reason=\"visibility state toggled by script\" id=\"review-more\">\n                    <article data-kid=\"1-3-3-1-4-1\">\n                        <div aria-hidden=\"true\" class=\"stars\" data-kid=\"1-3-3-1-4-1-1\">\n                            <span data-kid=\"1-3-3-1-4-1-1-1\">\n                                ★\n                            </span>\n                            <span data-kid=\"1-3-3-1-4-1-1-2\">\n                                ★\n                            </span>\n                            <span data-kid=\"1-3-3-1-4-1-1-3\">\n                                ★\n                            </span>\n                            <span data-kid=\"1-3-3-1-4-1-1-4\">\n                                ★\n                            </span>\n                            <span data-kid=\"1-3-3-1-4-1-1-5\">\n                                ★\n                            </span>\n                        </div>\n                        <blockquote data-kid=\"1-3-3-1-4-1-2\">\n                            “Super duper guy to deal with. On time. No mess left. Very mannerly and his price was on fleck too. Highly recommend Sam.”\n                        </blockquote>\n                        <p data-kid=\"1-3-3-1-4-1-3\">\n                            Gary Mcentee · Papatoetoe · 1 week ago\n                        </p>\n                    </article>\n                    <article data-kid=\"1-3-3-1-4-2\">\n                        <div aria-hidden=\"true\" class=\"stars\" data-kid=\"1-3-3-1-4-2-1\">\n                            <span data-kid=\"1-3-3-1-4-2-1-1\">\n                                ★\n                            </span>\n                            <span data-kid=\"1-3-3-1-4-2-1-2\">\n                                ★\n                            </span>\n                            <span data-kid=\"1-3-3-1-4-2-1-3\">\n                                ★\n                            </span>\n                            <span data-kid=\"1-3-3-1-4-2-1-4\">\n                                ★\n                            </span>\n                            <span data-kid=\"1-3-3-1-4-2-1-5\">\n                                ★\n                            </span>\n                        </div>\n                        <blockquote data-kid=\"1-3-3-1-4-2-2\">\n                            “Excellent service from Papatoetoe Plumbing and Gas. They were prompt, professional, and completed the job to a high standard. Highly recommended!”\n                        </blockquote>\n                        <p data-kid=\"1-3-3-1-4-2-3\">\n                            Priyank Patel · South Auckland · 1 week ago\n                        </p>\n                    </article>\n                    <article data-kid=\"1-3-3-1-4-3\">\n                        <div aria-hidden=\"true\" class=\"stars\" data-kid=\"1-3-3-1-4-3-1\">\n                            <span data-kid=\"1-3-3-1-4-3-1-1\">\n                                ★\n                            </span>\n                            <span data-kid=\"1-3-3-1-4-3-1-2\">\n                                ★\n                            </span>\n                            <span data-kid=\"1-3-3-1-4-3-1-3\">\n                                ★\n                            </span>\n                            <span data-kid=\"1-3-3-1-4-3-1-4\">\n                                ★\n                            </span>\n                            <span data-kid=\"1-3-3-1-4-3-1-5\">\n                                ★\n                            </span>\n                        </div>\n                        <blockquote data-kid=\"1-3-3-1-4-3-2\">\n                            “Highly recommend! Had my hot water cylinder replaced and couldn’t be happier with the service. Great communication, punctual, and reasonably priced.”\n                        </blockquote>\n                        <p data-kid=\"1-3-3-1-4-3-3\">\n                            Damith Herath · South Auckland · 2 weeks ago · Water heater installation\n                        </p>\n                    </article>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"services-title\" class=\"services-section section\" data-kid=\"1-3-4\" id=\"services\">\n            <div class=\"container\" data-kid=\"1-3-4-1\">\n                <div class=\"services-header\" data-kid=\"1-3-4-1-1\">\n                    <div data-kid=\"1-3-4-1-1-1\">\n                        <span class=\"eyebrow\" data-kid=\"1-3-4-1-1-1-1\">\n                            Choose the problem\n                        </span>\n                        <h2 class=\"section-title\" data-kid=\"1-3-4-1-1-1-2\" id=\"services-title\">\n                            What do you need help with?\n                        </h2>\n                    </div>\n                    <p class=\"services-intro\" data-kid=\"1-3-4-1-1-2\">\n                        Select a service to prefill the request docket. The list uses the same job language you’ll see when you contact us.\n                    </p>\n                </div>\n                <div class=\"service-index\" data-kid=\"1-3-4-1-2\" role=\"list\">\n                    <button aria-pressed=\"false\" class=\"service-row\" data-dynamic=\"true\" data-kid=\"1-3-4-1-2-1\" data-name=\"emergency plumbing service row\" data-reason=\"aria-pressed state updated by script\" data-service=\"Emergency plumbing\" role=\"listitem\" type=\"button\">\n                        <span class=\"service-no\" data-kid=\"1-3-4-1-2-1-1\">\n                            01\n                        </span>\n                        <span aria-hidden=\"true\" class=\"icon icon-navy\" data-kid=\"1-3-4-1-2-1-2\">\n                            <i class=\"ti ti-clock\" data-kid=\"1-3-4-1-2-1-2-1\">\n                            </i>\n                        </span>\n                        <span data-kid=\"1-3-4-1-2-1-3\">\n                            <h3 data-kid=\"1-3-4-1-2-1-3-1\">\n                                Emergency plumbing\n                            </h3>\n                            <p data-kid=\"1-3-4-1-2-1-3-2\">\n                                Burst pipes, overflowing toilets, ceiling leaks and urgent water shutoffs, day or night.\n                            </p>\n                        </span>\n                        <span aria-hidden=\"true\" class=\"service-arrow icon\" data-kid=\"1-3-4-1-2-1-4\">\n                            <i class=\"ti ti-arrow-right\" data-kid=\"1-3-4-1-2-1-4-1\">\n                            </i>\n                        </span>\n                    </button>\n                    <button aria-pressed=\"false\" class=\"service-row\" data-dynamic=\"true\" data-kid=\"1-3-4-1-2-2\" data-name=\"leak repairs service row\" data-reason=\"aria-pressed state updated by script\" data-service=\"Leak repairs\" role=\"listitem\" type=\"button\">\n                        <span class=\"service-no\" data-kid=\"1-3-4-1-2-2-1\">\n                            02\n                        </span>\n                        <span aria-hidden=\"true\" class=\"icon icon-navy\" data-kid=\"1-3-4-1-2-2-2\">\n                            <i class=\"ti ti-droplet\" data-kid=\"1-3-4-1-2-2-2-1\">\n                            </i>\n                        </span>\n                        <span data-kid=\"1-3-4-1-2-2-3\">\n                            <h3 data-kid=\"1-3-4-1-2-2-3-1\">\n                                Leak repairs\n                            </h3>\n                            <p data-kid=\"1-3-4-1-2-2-3-2\">\n                                Leak tracing, pipe repairs, mixer leaks and tidy permanent fixes before damage spreads.\n                            </p>\n                        </span>\n                        <span aria-hidden=\"true\" class=\"service-arrow icon\" data-kid=\"1-3-4-1-2-2-4\">\n                            <i class=\"ti ti-arrow-right\" data-kid=\"1-3-4-1-2-2-4-1\">\n                            </i>\n                        </span>\n                    </button>\n                    <button aria-pressed=\"false\" class=\"service-row\" data-dynamic=\"true\" data-kid=\"1-3-4-1-2-3\" data-name=\"blocked drains service row\" data-reason=\"aria-pressed state updated by script\" data-service=\"Blocked drains\" role=\"listitem\" type=\"button\">\n                        <span class=\"service-no\" data-kid=\"1-3-4-1-2-3-1\">\n                            03\n                        </span>\n                        <span aria-hidden=\"true\" class=\"icon icon-navy\" data-kid=\"1-3-4-1-2-3-2\">\n                            <i class=\"ti ti-wash\" data-kid=\"1-3-4-1-2-3-2-1\">\n                            </i>\n                        </span>\n                        <span data-kid=\"1-3-4-1-2-3-3\">\n                            <h3 data-kid=\"1-3-4-1-2-3-3-1\">\n                                Blocked drains\n                            </h3>\n                            <p data-kid=\"1-3-4-1-2-3-3-2\">\n                                Kitchen, bathroom and stormwater blockages cleared with practical diagnosis and no guesswork.\n                            </p>\n                        </span>\n                        <span aria-hidden=\"true\" class=\"service-arrow icon\" data-kid=\"1-3-4-1-2-3-4\">\n                            <i class=\"ti ti-arrow-right\" data-kid=\"1-3-4-1-2-3-4-1\">\n                            </i>\n                        </span>\n                    </button>\n                    <button aria-pressed=\"false\" class=\"service-row\" data-dynamic=\"true\" data-kid=\"1-3-4-1-2-4\" data-name=\"hot water service row\" data-reason=\"aria-pressed state updated by script\" data-service=\"Hot water\" role=\"listitem\" type=\"button\">\n                        <span class=\"service-no\" data-kid=\"1-3-4-1-2-4-1\">\n                            04\n                        </span>\n                        <span aria-hidden=\"true\" class=\"icon icon-navy\" data-kid=\"1-3-4-1-2-4-2\">\n                            <i class=\"ti ti-temperature\" data-kid=\"1-3-4-1-2-4-2-1\">\n                            </i>\n                        </span>\n                        <span data-kid=\"1-3-4-1-2-4-3\">\n                            <h3 data-kid=\"1-3-4-1-2-4-3-1\">\n                                Hot water\n                            </h3>\n                            <p data-kid=\"1-3-4-1-2-4-3-2\">\n                                No hot water, leaking cylinders, gas systems and continuous-flow upgrades.\n                            </p>\n                        </span>\n                        <span aria-hidden=\"true\" class=\"service-arrow icon\" data-kid=\"1-3-4-1-2-4-4\">\n                            <i class=\"ti ti-arrow-right\" data-kid=\"1-3-4-1-2-4-4-1\">\n                            </i>\n                        </span>\n                    </button>\n                    <button aria-pressed=\"false\" class=\"service-row\" data-dynamic=\"true\" data-kid=\"1-3-4-1-2-5\" data-name=\"gas fitting service row\" data-reason=\"aria-pressed state updated by script\" data-service=\"Gas fitting\" role=\"listitem\" type=\"button\">\n                        <span class=\"service-no\" data-kid=\"1-3-4-1-2-5-1\">\n                            05\n                        </span>\n                        <span aria-hidden=\"true\" class=\"icon icon-navy\" data-kid=\"1-3-4-1-2-5-2\">\n                            <i class=\"ti ti-flame\" data-kid=\"1-3-4-1-2-5-2-1\">\n                            </i>\n                        </span>\n                        <span data-kid=\"1-3-4-1-2-5-3\">\n                            <h3 data-kid=\"1-3-4-1-2-5-3-1\">\n                                Gas fitting\n                            </h3>\n                            <p data-kid=\"1-3-4-1-2-5-3-2\">\n                                Certified gas installs, servicing, safety checks, cooktops and appliance connections.\n                            </p>\n                        </span>\n                        <span aria-hidden=\"true\" class=\"service-arrow icon\" data-kid=\"1-3-4-1-2-5-4\">\n                            <i class=\"ti ti-arrow-right\" data-kid=\"1-3-4-1-2-5-4-1\">\n                            </i>\n                        </span>\n                    </button>\n                    <button aria-pressed=\"false\" class=\"service-row\" data-dynamic=\"true\" data-kid=\"1-3-4-1-2-6\" data-name=\"bathrooms and fixtures service row\" data-reason=\"aria-pressed state updated by script\" data-service=\"Bathrooms & fixtures\" role=\"listitem\" type=\"button\">\n                        <span class=\"service-no\" data-kid=\"1-3-4-1-2-6-1\">\n                            06\n                        </span>\n                        <span aria-hidden=\"true\" class=\"icon icon-navy\" data-kid=\"1-3-4-1-2-6-2\">\n                            <i class=\"ti ti-bath\" data-kid=\"1-3-4-1-2-6-2-1\">\n                            </i>\n                        </span>\n                        <span data-kid=\"1-3-4-1-2-6-3\">\n                            <h3 data-kid=\"1-3-4-1-2-6-3-1\">\n                                Bathrooms & fixtures\n                            </h3>\n                            <p data-kid=\"1-3-4-1-2-6-3-2\">\n                                Tapware, toilets, showers, vanities, laundry plumbing and bathroom renovation fit-offs.\n                            </p>\n                        </span>\n                        <span aria-hidden=\"true\" class=\"service-arrow icon\" data-kid=\"1-3-4-1-2-6-4\">\n                            <i class=\"ti ti-arrow-right\" data-kid=\"1-3-4-1-2-6-4-1\">\n                            </i>\n                        </span>\n                    </button>\n                </div>\n                <p class=\"service-footnote\" data-kid=\"1-3-4-1-3\">\n                    Not listed? Choose\n                    <a data-kid=\"1-3-4-1-3-1\" data-select-other=\"\" href=\"#request\">\n                        Other (describe if not listed)\n                    </a>\n                    in the request docket.\n                </p>\n            </div>\n        </section>\n        <section aria-labelledby=\"work-title\" class=\"work-section section\" data-kid=\"1-3-5\" id=\"work\">\n            <div class=\"container\" data-kid=\"1-3-5-1\">\n                <div class=\"work-header\" data-kid=\"1-3-5-1-1\">\n                    <div data-kid=\"1-3-5-1-1-1\">\n                        <span class=\"eyebrow\" data-kid=\"1-3-5-1-1-1-1\">\n                            Work completed nearby\n                        </span>\n                        <h2 class=\"section-title\" data-kid=\"1-3-5-1-1-1-2\" id=\"work-title\">\n                            Real plumbing work across Papatoetoe.\n                        </h2>\n                    </div>\n                    <p data-kid=\"1-3-5-1-1-2\">\n                        From urgent leaks to hot water upgrades and gas installs, the focus is on safe, long-term fixes and tidy work homeowners can trust.\n                    </p>\n                </div>\n                <div class=\"work-grid\" data-kid=\"1-3-5-1-2\">\n                    <figure class=\"work-figure\" data-kid=\"1-3-5-1-2-1\">\n                        <div class=\"work-image-frame\" data-kid=\"1-3-5-1-2-1-1\">\n                            <img alt=\"Completed Papatoetoe plumbing repair with tidy pipework\" data-kid=\"1-3-5-1-2-1-1-1\" decoding=\"async\" height=\"640\" loading=\"lazy\" src=\"/api/local/images/src/assets/unnamed-11.jpeg\" width=\"480\"/>\n                        </div>\n                        <figcaption class=\"work-caption\" data-kid=\"1-3-5-1-2-1-2\">\n                            <span class=\"work-no\" data-kid=\"1-3-5-1-2-1-2-1\">\n                                Work 01\n                            </span>\n                            <strong data-kid=\"1-3-5-1-2-1-2-2\">\n                                Completed Papatoetoe plumbing repair with tidy pipework\n                            </strong>\n                            <span data-kid=\"1-3-5-1-2-1-2-3\">\n                                Existing project photograph\n                            </span>\n                        </figcaption>\n                    </figure>\n                    <figure class=\"work-figure work-figure--offset\" data-kid=\"1-3-5-1-2-2\">\n                        <div class=\"work-image-frame\" data-kid=\"1-3-5-1-2-2-1\">\n                            <img alt=\"Before and after plumbing project photo in South Auckland\" data-kid=\"1-3-5-1-2-2-1-1\" decoding=\"async\" height=\"1020\" loading=\"lazy\" src=\"/api/local/images/src/assets/unnamed-6.jpeg\" width=\"765\"/>\n                        </div>\n                        <figcaption class=\"work-caption\" data-kid=\"1-3-5-1-2-2-2\">\n                            <span class=\"work-no\" data-kid=\"1-3-5-1-2-2-2-1\">\n                                Work 02\n                            </span>\n                            <strong data-kid=\"1-3-5-1-2-2-2-2\">\n                                Before and after plumbing project photo in South Auckland\n                            </strong>\n                            <span data-kid=\"1-3-5-1-2-2-2-3\">\n                                Existing project photograph\n                            </span>\n                        </figcaption>\n                    </figure>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"areas-title\" class=\"areas-section section\" data-kid=\"1-3-6\" id=\"areas\">\n            <div class=\"container\" data-kid=\"1-3-6-1\">\n                <span class=\"eyebrow\" data-kid=\"1-3-6-1-1\">\n                    Local coverage\n                </span>\n                <h2 class=\"section-title\" data-kid=\"1-3-6-1-2\" id=\"areas-title\">\n                    Areas we cover\n                </h2>\n                <div class=\"areas-grid\" data-kid=\"1-3-6-1-3\">\n                    <div class=\"area-intro\" data-kid=\"1-3-6-1-3-1\">\n                        <span aria-hidden=\"true\" class=\"icon icon-amber\" data-kid=\"1-3-6-1-3-1-1\">\n                            <i class=\"ti ti-map-pin\" data-kid=\"1-3-6-1-3-1-1-1\">\n                            </i>\n                        </span>\n                        <h3 data-kid=\"1-3-6-1-3-1-2\">\n                            Papatoetoe and South Auckland\n                        </h3>\n                        <p data-kid=\"1-3-6-1-3-1-3\">\n                            Local plumbing and gas help across the suburbs listed here.\n                        </p>\n                    </div>\n                    <ul class=\"area-list\" data-kid=\"1-3-6-1-3-2\">\n                        <li data-kid=\"1-3-6-1-3-2-1\">\n                            Papatoetoe\n                        </li>\n                        <li data-kid=\"1-3-6-1-3-2-2\">\n                            Manukau\n                        </li>\n                        <li data-kid=\"1-3-6-1-3-2-3\">\n                            Mangere\n                        </li>\n                        <li data-kid=\"1-3-6-1-3-2-4\">\n                            Mangere East\n                        </li>\n                        <li data-kid=\"1-3-6-1-3-2-5\">\n                            Otara\n                        </li>\n                        <li data-kid=\"1-3-6-1-3-2-6\">\n                            Flat Bush\n                        </li>\n                    </ul>\n                    <ul class=\"area-list\" data-kid=\"1-3-6-1-3-3\">\n                        <li data-kid=\"1-3-6-1-3-3-1\">\n                            East Tamaki\n                        </li>\n                        <li data-kid=\"1-3-6-1-3-3-2\">\n                            Otahuhu\n                        </li>\n                        <li data-kid=\"1-3-6-1-3-3-3\">\n                            Favona\n                        </li>\n                        <li data-kid=\"1-3-6-1-3-3-4\">\n                            Wiri\n                        </li>\n                        <li data-kid=\"1-3-6-1-3-3-5\">\n                            Takanini\n                        </li>\n                        <li data-kid=\"1-3-6-1-3-3-6\">\n                            Papakura\n                        </li>\n                    </ul>\n                    <ul class=\"area-list\" data-kid=\"1-3-6-1-3-4\">\n                        <li data-kid=\"1-3-6-1-3-4-1\">\n                            Manurewa\n                        </li>\n                        <li data-kid=\"1-3-6-1-3-4-2\">\n                            Clendon Park\n                        </li>\n                        <li data-kid=\"1-3-6-1-3-4-3\">\n                            Randwick Park\n                        </li>\n                        <li data-kid=\"1-3-6-1-3-4-4\">\n                            Goodwood Heights\n                        </li>\n                        <li data-kid=\"1-3-6-1-3-4-5\">\n                            Hillpark\n                        </li>\n                        <li data-kid=\"1-3-6-1-3-4-6\">\n                            The Gardens\n                        </li>\n                        <li data-kid=\"1-3-6-1-3-4-7\">\n                            Airport Oaks\n                        </li>\n                        <li data-kid=\"1-3-6-1-3-4-8\">\n                            Auckland Airport\n                        </li>\n                        <li data-kid=\"1-3-6-1-3-4-9\">\n                            Clover Park\n                        </li>\n                        <li data-kid=\"1-3-6-1-3-4-10\">\n                            Totara Heights\n                        </li>\n                        <li data-kid=\"1-3-6-1-3-4-11\">\n                            Puhinui\n                        </li>\n                        <li data-kid=\"1-3-6-1-3-4-12\">\n                            Middlemore\n                        </li>\n                    </ul>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"closing-title\" class=\"closing-cta\" data-kid=\"1-3-7\">\n            <div class=\"container closing-inner\" data-kid=\"1-3-7-1\">\n                <div data-kid=\"1-3-7-1-1\">\n                    <span class=\"eyebrow\" data-kid=\"1-3-7-1-1-1\">\n                        Need help now?\n                    </span>\n                    <h2 class=\"section-title\" data-kid=\"1-3-7-1-1-2\" id=\"closing-title\">\n                        Get the right next step for your plumbing problem.\n                    </h2>\n                    <p class=\"closing-copy\" data-kid=\"1-3-7-1-1-3\">\n                        For urgent leaks, blocked drains, hot water failures, gas issues and bathroom work across Papatoetoe and South Auckland.\n                    </p>\n                </div>\n                <div class=\"closing-actions\" data-kid=\"1-3-7-1-2\">\n                    <a class=\"btn btn-call\" data-kid=\"1-3-7-1-2-1\" href=\"tel:+6498844104\">\n                        <span aria-hidden=\"true\" class=\"icon icon-ink\" data-kid=\"1-3-7-1-2-1-1\">\n                            <i class=\"ti ti-phone-call\" data-kid=\"1-3-7-1-2-1-1-1\">\n                            </i>\n                        </span>\n                        Call 64 9 8844104\n                    </a>\n                    <a class=\"btn btn-outline-light\" data-kid=\"1-3-7-1-2-2\" href=\"#request\">\n                        Request service\n                    </a>\n                </div>\n            </div>\n        </section>\n    </main>\n    <footer class=\"site-footer\" data-kid=\"1-4\">\n        <div class=\"container footer-inner\" data-kid=\"1-4-1\">\n            <div data-kid=\"1-4-1-1\">\n                <div class=\"footer-brand\" data-kid=\"1-4-1-1-1\">\n                    Papatoetoe\n                    <span data-kid=\"1-4-1-1-1-1\">\n                        Plumbing & Gas\n                    </span>\n                </div>\n                <p class=\"footer-copy\" data-kid=\"1-4-1-1-2\">\n                    24/7 emergency plumbing, hot water and gas across Papatoetoe and South Auckland.\n                </p>\n            </div>\n            <a class=\"footer-phone\" data-kid=\"1-4-1-2\" href=\"tel:+6498844104\">\n                64 9 8844104\n            </a>\n        </div>\n    </footer>\n    <div aria-label=\"Quick contact\" class=\"mobile-dock\" data-kid=\"1-5\">\n        <a class=\"btn btn-call\" data-kid=\"1-5-1\" href=\"tel:+6498844104\">\n            <span aria-hidden=\"true\" class=\"icon icon-ink\" data-kid=\"1-5-1-1\">\n                <i class=\"ti ti-phone-call\" data-kid=\"1-5-1-1-1\">\n                </i>\n            </span>\n            Call now\n        </a>\n        <a class=\"btn btn-request\" data-kid=\"1-5-2\" href=\"#request\">\n            Request service\n        </a>\n    </div>\n</div>\n<script>\n    (() => {\n    const serviceSelect = document.getElementById('service');\n    const selectedNote = document.getElementById('selected-note');\n    const serviceRows = Array.from(document.querySelectorAll('[data-service]'));\n    const requestForm = document.getElementById('request-form');\n    const formStatus = document.getElementById('form-status');\n    const submitButton = document.getElementById('submit-request');\n    const reviewToggle = document.getElementById('reviews-toggle');\n    const reviewMore = document.getElementById('review-more');\n    const otherLink = document.querySelector('[data-select-other]');\n\n    const selectService = (value) => {\n      if (!serviceSelect) return;\n      serviceSelect.value = value;\n      if (selectedNote) selectedNote.textContent = `Selected: ${value}`;\n      serviceRows.forEach((row) => {\n        const selected = row.dataset.service === value;\n        row.classList.toggle('is-selected', selected);\n        row.setAttribute('aria-pressed', String(selected));\n      });\n    };\n\n    serviceRows.forEach((row) => row.addEventListener('click', () => selectService(row.dataset.service)));\n    serviceSelect.addEventListener('change', () => selectService(serviceSelect.value));\n    if (otherLink) otherLink.addEventListener('click', () => selectService('Other (describe if not listed)'));\n\n    reviewToggle.addEventListener('click', () => {\n      const open = reviewToggle.getAttribute('aria-expanded') === 'true';\n      reviewToggle.setAttribute('aria-expanded', String(!open));\n      reviewMore.classList.toggle('is-open', !open);\n      reviewMore.setAttribute('aria-hidden', String(open));\n      reviewToggle.querySelector('span:first-child').textContent = open ? 'Read all Google reviews' : 'Hide additional reviews';\n      reviewToggle.querySelector('.ti').className = open ? 'ti ti-arrow-down' : 'ti ti-arrow-up';\n    });\n\n    requestForm.addEventListener('submit', (event) => {\n      event.preventDefault();\n      if (!requestForm.checkValidity()) {\n        formStatus.textContent = 'Please add your name and phone number so we can respond.';\n        formStatus.classList.add('is-visible', 'is-error');\n        requestForm.reportValidity();\n        return;\n      }\n      submitButton.disabled = true;\n      submitButton.querySelector('span:last-child').textContent = 'Sending request…';\n      window.setTimeout(() => {\n        submitButton.disabled = false;\n        submitButton.querySelector('span:last-child').textContent = 'Send request';\n        formStatus.textContent = 'Request sent. We’ll call you back shortly. For urgent help, call 64 9 8844104.';\n        formStatus.classList.remove('is-error');\n        formStatus.classList.add('is-visible');\n      }, 550);\n    });\n  })();\n</script>\n",
